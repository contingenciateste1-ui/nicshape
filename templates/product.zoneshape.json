          },
          "blocks": {}
        },
        "ai_gen_block_285f89b_NU9mWC": {
          "type": "ai_gen_block_285f89b",
          "name": "Image and text card",
          "settings": {
            "image": "shopify://shop_images/Section.webp",
            "image_position": "right",
            "heading_part_one": "For ALL Women. Really.",
            "heading_part_two": "",
            "bullet_list": "Size XS to 4XL. Petite to plus size. New mom to event queen.\n\nPostpartum? Safe after 4-6 weeks. Long nails? Won't tear. Hot weather? Breathable zones. First shapewear? Start here.\n\nMade for YOUR body. Ultra-stretch fabric expands 3-4x. Looks tiny in the box. Trust the process.\n\nWhat's included:\n\n\nAdjustable straps\nOpen gusset\n3+ colors",
            "closing_line": "",
            "heading_size": 32,
