              "name": "Selecionador de Variantes",
              "settings": {
                "custom_liquid": "{% comment %}\n  HORIZON | Seletor visual de cores + tamanhos — bloco Custom Liquid.\n  IMPORTANTE: manter o bloco nativo \"Variant picker\" na pagina, acima ou abaixo\n  deste bloco. Ele sera ocultado visualmente APENAS quando a integracao funcionar.\n  O JS aciona os inputs nativos do Horizon; nao mexe no carrinho nem no form.\n{% endcomment %}\n\n{% assign hvs_product = closest.product | default: product %}\n{% if hvs_product != blank and hvs_product.has_only_default_variant == false %}\n\n<style>\n  .hvs-picker {\n    font-family: Arial, Helvetica, sans-serif;\n    color: #111;\n    width: 100%;\n    max-width: 100%;\n    padding: 0;\n  }\n  /* Fallback: caso o Horizon nao tenha o seletor nativo, exibe apenas o original. */\n  .hvs-picker:not([data-hvs-ready=\"true\"]) { display: none !important; }\n  .hvs-picker, .hvs-picker * { box-sizing: border-box; }\n  .hvs-picker__group { margin: 0 0 35px; }\n  .hvs-picker__group:last-child { margin-bottom: 0; }\n  .hvs-picker__heading {\n    margin: 0 0 13px;\n    font-family: Arial, Helvetica, sans-serif;\n    font-weight: 400;\n    font-size: 13px;\n    line-height: 1.5;\n    color: #111;\n  }\n  .hvs-picker__heading strong { font-weight: 700; }\n  .hvs-picker__choices { display: flex; align-items: center; flex-wrap: wrap; }\n  .hvs-picker__choices--colors { gap: 12px; padding: 4px 5px 3px; }\n  .hvs-picker__color {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    position: relative;\n    flex: 0 0 32px;\n    width: 32px;\n    height: 32px;\n    margin: 0;\n    padding: 0;\n    border: none;\n    border-radius: 50%;\n    background: transparent;\n    cursor: pointer;\n    appearance: none;\n    -webkit-appearance: none;\n  }\n  .hvs-picker__color-dot {\n    width: 32px;\n    height: 32px;\n    display: block;\n    border-radius: 50%;\n    border: 1px solid rgba(0, 0, 0, 0.13);\n    background: var(--hvs-color, #ddd);\n  }\n  .hvs-picker__color[aria-pressed=\"true\"]::after {\n    content: \"\";\n    position: absolute;\n    inset: -5px;\n    border: 3px solid #0b0b0b;\n    border-radius: 50%;\n    pointer-events: none;\n  }\n  .hvs-picker__color:focus-visible { outline: 2px solid #456cb7; outline-offset: 7px; }\n  .hvs-picker__choices--sizes { gap: 8px; }\n  .hvs-picker__size {\n    appearance: none;\n    -webkit-appearance: none;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    min-width: 53px;\n    min-height: 40px;\n    padding: 0 12px;\n    margin: 0;\n    background: #fff;\n    border: 1px solid #e7e7e7;\n    border-radius: 4px;\n    font: 400 13px/1.3 Arial, Helvetica, sans-serif;\n    color: #111;\n    text-align: center;\n    white-space: nowrap;\n    cursor: pointer;\n    transition: border-color .15s, background-color .15s, color .15s;\n  }\n  .hvs-picker__size:hover { border-color: #777; }\n  .hvs-picker__size[aria-pressed=\"true\"] {\n    background: #292929;\n    border-color: #292929;\n    color: #fff;\n    font-weight: 700;\n  }\n  .hvs-picker__size:focus-visible { outline: 2px solid #456cb7; outline-offset: 2px; }\n  @media (max-width: 749px) {\n    .hvs-picker__choices--sizes { gap: 7px; }\n    .hvs-picker__size { min-width: 48px; padding: 0 10px; }\n  }\n  /* Oculta visualmente somente o picker nativo deste produto, mantendo o JS vivo. */\n  .product-details:has(.hvs-picker[data-hvs-ready=\"true\"])\n  variant-picker[data-product-id=\"{{ hvs_product.id }}\"] {\n    position: absolute !important;\n    width: 1px !important;\n    height: 1px !important;\n    padding: 0 !important;\n    margin: 0 !important;\n    opacity: 0 !important;\n    overflow: hidden !important;\n    clip-path: inset(50%) !important;\n    pointer-events: none !important;\n  }\n</style>\n\n<div class=\"hvs-picker\" data-hvs-product-id=\"{{ hvs_product.id }}\" aria-label=\"Product options\">\n  {% for hvs_option in hvs_product.options_with_values %}\n    {% assign hvs_option_name = hvs_option.name | downcase | strip %}\n    {% assign hvs_is_color = false %}\n    {% if hvs_option_name contains 'color' or hvs_option_name contains 'colour' or hvs_option_name contains 'cor' or hvs_option_name contains 'colore' or hvs_option_name contains 'couleur' %}\n      {% assign hvs_is_color = true %}\n    {% endif %}\n    <div class=\"hvs-picker__group\" data-hvs-option-name=\"{{ hvs_option.name | escape }}\">\n      <div class=\"hvs-picker__heading\">\n        {{ hvs_option.name | escape }}: <strong data-hvs-selected>{{ hvs_option.selected_value | escape }}</strong>\n      </div>\n      <div class=\"hvs-picker__choices {% if hvs_is_color %}hvs-picker__choices--colors{% else %}hvs-picker__choices--sizes{% endif %}\">\n        {% for hvs_value in hvs_option.values %}\n          {% assign hvs_value_lower = hvs_value | downcase | strip %}\n          {% if hvs_is_color %}\n            {% assign hvs_chip = '#d3d3d3' %}\n            {% case hvs_value_lower %}\n              {% when 'black' or 'preto' or 'negro' or 'noir' %}{% assign hvs_chip = '#050505' %}\n              {% when 'brown' or 'marrom' or 'marrón' or 'marron' or 'chocolate' %}{% assign hvs_chip = '#593b31' %}\n              {% when 'beige' or 'nude' or 'sand' or 'areia' or 'arena' %}{% assign hvs_chip = '#d4b997' %}\n              {% when 'white' or 'branco' or 'blanco' or 'blanc' %}{% assign hvs_chip = '#ffffff' %}\n              {% when 'grey' or 'gray' or 'cinza' or 'gris' %}{% assign hvs_chip = '#858585' %}\n              {% when 'navy' or 'navy blue' or 'azul marinho' %}{% assign hvs_chip = '#23324b' %}\n              {% when 'blue' or 'azul' or 'bleu' %}{% assign hvs_chip = '#416f9d' %}\n              {% when 'red' or 'rojo' or 'vermelho' or 'rouge' %}{% assign hvs_chip = '#b33535' %}\n              {% when 'green' or 'verde' or 'vert' %}{% assign hvs_chip = '#526d50' %}\n              {% when 'olive' or 'oliva' %}{% assign hvs_chip = '#74744a' %}\n              {% when 'pink' or 'rosa' or 'rose' %}{% assign hvs_chip = '#dba7b5' %}\n              {% when 'cream' or 'crema' or 'creme' or 'ivory' %}{% assign hvs_chip = '#f0e6d3' %}\n              {% when 'camel' %}{% assign hvs_chip = '#b89161' %}\n              {% when 'burgundy' or 'wine' or 'vinho' or 'vino' %}{% assign hvs_chip = '#622b3b' %}\n              {% when 'khaki' or 'caqui' %}{% assign hvs_chip = '#afa381' %}\n            {% endcase %}\n            {% if hvs_value.swatch.color != blank %}\n              {% assign hvs_chip = hvs_value.swatch.color %}\n            {% endif %}\n            <button\n              type=\"button\"\n              class=\"hvs-picker__color\"\n              data-hvs-value=\"{{ hvs_value | escape }}\"\n              aria-label=\"{{ hvs_option.name | escape }}: {{ hvs_value | escape }}\"\n              title=\"{{ hvs_value | escape }}\"\n              aria-pressed=\"{% if hvs_value.selected %}true{% else %}false{% endif %}\"\n              style=\"--hvs-color: {{ hvs_chip }};\"\n            ><span class=\"hvs-picker__color-dot\" aria-hidden=\"true\"></span></button>\n          {% else %}\n            <button\n              type=\"button\"\n              class=\"hvs-picker__size\"\n              data-hvs-value=\"{{ hvs_value | escape }}\"\n              aria-pressed=\"{% if hvs_value.selected %}true{% else %}false{% endif %}\"\n            >{{ hvs_value | escape }}</button>\n          {% endif %}\n        {% endfor %}\n      </div>\n    </div>\n  {% endfor %}\n</div>\n\n<script>\n(function () {\n  const root = document.currentScript && document.currentScript.previousElementSibling;\n  if (!root || !root.classList.contains('hvs-picker') || root.dataset.hvsBound) return;\n  root.dataset.hvsBound = 'true';\n\n  const details = root.closest('.product-details');\n  if (!details) return;\n  const findPicker = () => Array.from(details.querySelectorAll('variant-picker'))\n    .find(p => p.dataset.productId === root.dataset.hvsProductId && p.querySelector('.variant-picker__form'));\n  const picker = findPicker();\n  if (!picker) {\n    console.warn('[Horizon swatches] Mantenha o bloco nativo \"Variant picker\" no mesmo grupo Product details.');\n    return;\n  }\n\n  function nativeSelection(optionName) {\n    const radios = Array.from(picker.querySelectorAll('input[type=\"radio\"][data-option-name]'));\n    const checked = radios.find(r => r.dataset.optionName === optionName && r.checked);\n    if (checked) return checked.value;\n    const selects = Array.from(picker.querySelectorAll('select'));\n    const select = selects.find(s => Array.from(s.options).some(o => o.dataset.optionName === optionName));\n    if (select) return select.value;\n    return null;\n  }\n\n  function sync() {\n    for (const group of root.querySelectorAll('[data-hvs-option-name]')) {\n      const chosen = nativeSelection(group.dataset.hvsOptionName);\n      const previous = group.querySelector('[data-hvs-selected]')?.textContent;\n      const value = chosen === null ? previous : chosen;\n      const label = group.querySelector('[data-hvs-selected]');\n      if (label && value != null) label.textContent = value;\n      for (const button of group.querySelectorAll('[data-hvs-value]')) {\n        button.setAttribute('aria-pressed', String(button.dataset.hvsValue === value));\n      }\n    }\n  }\n\n  root.addEventListener('click', function (event) {\n    const button = event.target.closest('button[data-hvs-value]');\n    if (!button || !root.contains(button)) return;\n    const group = button.closest('[data-hvs-option-name]');\n    if (!group) return;\n    const name = group.dataset.hvsOptionName;\n    const value = button.dataset.hvsValue;\n    const radio = Array.from(picker.querySelectorAll('input[type=\"radio\"][data-option-name]'))\n      .find(input => input.dataset.optionName === name && input.value === value);\n\n    if (radio) {\n      if (!radio.checked) {\n        radio.checked = true;\n        radio.dispatchEvent(new Event('change', { bubbles: true }));\n      }\n    } else {\n      const select = Array.from(picker.querySelectorAll('select'))\n        .find(el => Array.from(el.options).some(o => o.dataset.optionName === name && o.value === value));\n      if (select) {\n        if (select.value !== value) {\n          select.value = value;\n          select.dispatchEvent(new Event('change', { bubbles: true }));\n        }\n      } else if (nativeSelection(name) !== value) {\n        console.warn('[Horizon swatches] Opcao nativa nao encontrada:', name, value);\n        return;\n      }\n    }\n    const label = group.querySelector('[data-hvs-selected]');\n    if (label) label.textContent = value;\n    for (const item of group.querySelectorAll('[data-hvs-value]')) {\n      item.setAttribute('aria-pressed', String(item.dataset.hvsValue === value));\n    }\n    requestAnimationFrame(sync);\n  });\n\n  picker.addEventListener('change', function () { requestAnimationFrame(sync); });\n  const observer = new MutationObserver(function () { requestAnimationFrame(sync); });\n  observer.observe(picker, { subtree: true, childList: true, attributes: true, attributeFilter: ['checked', 'selected', 'data-current-checked'] });\n  sync();\n  root.dataset.hvsReady = 'true';\n})();\n</script>\n{% endif %}"
              },
