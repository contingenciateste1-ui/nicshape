        "ai_gen_block_61cc85d_FciFCK": {
          "type": "ai_gen_block_61cc85d",
          "settings": {
            "heading": "Why it has become everyone's favorite",
            "subheading": "",
            "heading_size": 36,
            "desktop_width_percent": 100,
            "video": "shopify://files/videos/gif1.mp4",
            "media_position": "right",
            "media_radius": 20,
            "feature_1_icon": "shopify://shop_images/Tummy.webp",
            "feature_1_title": "Flat Tummy in 10 Seconds",
            "feature_1_description": "Zoned Compression Technology™ puts intense compression exactly where you need it — your belly. FUPA, mom pouch, lower belly: flattened instantly. The thicker abdominal panel sucks everything in while the rest stays light. Two pant sizes smaller. No diet. No gym.",
            "feature_2_icon": "shopify://shop_images/bottom.webp",
            "feature_2_title": "Lifts Your Butt, Never Flattens It",
            "feature_2_description": "3D structured panels lift and shape your butt without flattening it. You get the shelf, the roundness, the bounce — without surgery, without pain, without $5,000. “They asked if I got work done. No guys, it’s just the bodysuit",
            "feature_3_icon": "shopify://shop_images/privacy.webp",
            "feature_3_title": "Invisible Under Everything",
            "feature_3_description": "100% seamless. Disappears under silk dresses, fitted jeans, white shirts, leggings. Even the back is completely smooth — zero lines, zero edges. Wear it under satin and nobody will ever know",
            "feature_4_icon": "shopify://shop_images/12-hours.webp",
            "feature_4_title": "Wear It 12+ Hours. Forget It's On",
            "feature_4_description": "Steel on the belly. Silk on the rest. The bust and thighs are ultra-light and breathable so you never get that end-of-day suffocating feeling. Eat, dance, work, sleep. It moves with you, not against you.",
            "background_color": "#ffffff",
            "text_color": "#2b2224",
            "description_color": "#5f5557",
            "padding_vertical_desktop": 32,
            "padding_horizontal_desktop": 80,
            "padding_vertical_mobile": 8,
            "padding_horizontal_mobile": 16
          },
          "blocks": {}
        },
        "ai_gen_block_285f89b_8ryqmh": {
          "type": "ai_gen_block_285f89b",
          "settings": {
            "image": "shopify://shop_images/Section2.webp",
            "image_position": "left",
            "heading_part_one": "The 10-Second Body Transformation",
            "heading_part_two": "",
            "bullet_list": "Before: Belly out, flat butt, back rolls\n\nAfter: Flat tummy, lifted butt, hourglass silhouette\n\nNot magic. Zoned Compression Technology™ — three zones, one bodysuit. Compression on the tummy. Lift on the butt. Breathable everywhere else.\n\nForget about:\n\nShapewear that suffocates you\nRolling up every 30 minutes\nFlattening your butt to flatten your belly\nFull strip-down for the bathroom\nVisible lines under clothes\nWith ZoneShape™:\n\nFlat tummy without suffocating\nLifted butt, not flat butt\nInvisible under even silk dresses\nBathroom in 30 seconds\n12+ hours, forget it's on",
            "closing_line": "",
            "heading_size": 26,
            "text_size": 13,
            "heading_color_one": "#3b2f2a",
            "heading_color_two": "#7a6a5c",
            "text_color": "#111111",
            "card_background": "#ffffff",
            "border_color": "#ece6e2",
