      "type": "nic-faq",
      "blocks": {
        "question_pT9n9i": {
          "type": "question",
          "settings": {
            "question": "What's special about these jeans?",
            "answer": "<p>They have three innovations:</p><p><strong>Curve-Sculpt™ Technology:</strong></p><p>98% Premium Cotton + 2% Spandex that adapts to your body and naturally lifts your booty.</p><p><strong>Zero gap design:</strong></p><p>The mid-low rise hugs perfectly without leaving empty spaces.</p><p><strong>Flattering wide leg:</strong></p><p>Hugs the butt, then flares out. Follow the trend without losing your curves.</p>",
            "open": false
          }
        },
        "question_UGzjUG": {
          "type": "question",
          "settings": {
            "question": "Is it real denim or plasticky like jeggings?",
            "answer": "<p></p><p><strong>REAL DENIM with 98% Cotton.</strong></p><p>Touch it and feel the difference.</p><p>Unlike jeggings:</p><ul><li>Authentic premium jeans look</li><li>Natural cotton texture</li><li>Real functional pockets</li><li>Classic button and zipper</li></ul>",
            "open": false
          }
        },
        "question_rGxXCE": {
          "type": "question",
          "settings": {
            "question": "Does it really flatter or is it just comfortable?",
            "answer": "<p>YES! The 2% Spandex woven into the cotton gives you the same effect as push-up jeans, but without stiffness.</p><p>Perfect for: work, evenings out, dates, casual weekends.</p>",
            "open": false
          }
        },
        "question_PB6MiJ": {
          "type": "question",
          "settings": {
            "question": "Will I see a gap in the waist?",
            "answer": "<p>NO! Zero gap guaranteed. The mid-low rise design hugs your body perfectly. No empty space, no pulling up your pants.</p>",
            "open": false
          }
        },
        "question_UPbCRf": {
          "type": "question",
          "settings": {
            "question": "Do the colors fade?",
            "answer": "<p>Like any quality real denim, the first washes may release some color. Wash inside out, cold water, like colors, no bleach. After 2-3 washes the color stabilizes.</p>",
            "open": false
          }
        },
        "question_dypXmn": {
          "type": "question",
          "settings": {
            "question": "How do I wash them?",
            "answer": "<p></p><ul><li>Machine wash cold, inside out, like colors</li><li>Do NOT bleach</li><li>Tumble dry low or hang to air dry</li><li>Warm iron if needed</li></ul>",
            "open": false
          }
        },
        "question_MJyWNV": {
          "type": "question",
          "settings": {
            "question": "When will my order arrive?",
            "answer": "<p></p><p><strong>SHIPPING TIMES:</strong></p><p>Arrives in 5-7 days</p><p><strong>WHAT YOU GET:</strong></p><p>📦 Tracking number to follow your package</p><p>📞 Support always available if you have questions</p><p><strong>ATTENTION:</strong> Sizes are selling out fast. If you see your size available, grab it now!</p>",
            "open": false
          }
        },
        "question_TG7XW8": {
          "type": "question",
          "settings": {
            "question": "What if I don't like it?",
            "answer": "<p>You can return it within [30] days. Email <strong>info@nicshape.com</strong> and we will guide you through the return and refund.</p>",
            "open": false
          }
        }
