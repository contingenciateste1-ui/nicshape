            "custom_liquid_8ifdB7": {
              "type": "custom-liquid",
              "name": "Accordeon",
              "settings": {
                "custom_liquid": "<div class=\"vr-accordion\">\n\n  <!-- DESCRIPTION -->\n  <details class=\"vr-accordion__item\">\n    <summary class=\"vr-accordion__heading\">\n      <span>Description</span>\n      <svg class=\"vr-accordion__chevron\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.3\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">\n        <path d=\"m6 9 6 6 6-6\"/>\n      </svg>\n    </summary>\n    <div class=\"vr-accordion__content vr-accordion__rte\">\n      {{ product.description }}\n    </div>\n  </details>\n\n  <!-- SHIPPING -->\n  <details class=\"vr-accordion__item\">\n    <summary class=\"vr-accordion__heading\">\n      <span>Shipping</span>\n      <svg class=\"vr-accordion__chevron\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.3\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">\n        <path d=\"m6 9 6 6 6-6\"/>\n      </svg>\n    </summary>\n    <div class=\"vr-accordion__content\">\n      <p><strong>Free tracked shipping on all orders.</strong></p>\n      <p>The estimated delivery time is <strong>5–7 days</strong>. If your country appears at checkout, shipping is available for your area.</p>\n    </div>\n  </details>\n\n  <!-- MATERIALS & CARE -->\n  <details class=\"vr-accordion__item\">\n    <summary class=\"vr-accordion__heading\">\n      <span>Materials &amp; Care</span>\n      <svg class=\"vr-accordion__chevron\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.3\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">\n        <path d=\"m6 9 6 6 6-6\"/>\n      </svg>\n    </summary>\n    <div class=\"vr-accordion__content\">\n      <p><strong>Materials:</strong> Premium blend: 77% Nylon, 23% Spandex. Seamless 360° construction. Multi-zone targeted compression (strong tummy, moderate thighs, zero bust compression). Ultra-soft, breathable, second-skin feel. Snap crotch for easy bathroom access.</p>\n      <p><strong>Washing Instructions:</strong></p>\n      <p>Wash at 30°C (delicate cycle or hand wash): The seamless construction maintains its compression and shape wash after wash. Unlike cheap shapewear that loses its hold after 2 washes.</p>\n      <p>Regular detergent, NO bleach/softener: Bleach damages the compression fibers and softener reduces the sculpting effectiveness.</p>\n      <p>Air dry flat or hanging (NEVER tumble dryer): Heat destroys spandex elasticity. Your bodysuit will lose its compression power. Avoid direct sunlight or color fades.</p>\n      <p>Store flat or folded neatly: Don’t bunch it up in a drawer — fold it flat to preserve the seamless shape.</p>\n      <p><strong>Tip:</strong> Get 2–3 and rotate weekly — they’ll last twice as long. Nude for everyday, Black for going out, Beige for lighter outfits.</p>\n    </div>\n  </details>\n\n  <!-- SIZE -->\n  <details class=\"vr-accordion__item\">\n    <summary class=\"vr-accordion__heading\">\n      <span>Size</span>\n      <svg class=\"vr-accordion__chevron\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.3\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">\n        <path d=\"m6 9 6 6 6-6\"/>\n      </svg>\n    </summary>\n    <div class=\"vr-accordion__content vr-accordion__content--size\">\n      <img\n        src=\"https://cdn.shopify.com/s/files/1/0791/0994/7505/files/Size_Chart_Body.webp?v=1793648280\"\n        alt=\"Size guide with chest, waist, hips, front length and back length measurements\"\n        width=\"406\"\n        height=\"503\"\n        loading=\"lazy\"\n      >\n    </div>\n  </details>\n</div>\n\n<style>\n  /* Herda a fonte do tema Horizon sem carregar fontes externas. */\n  .vr-accordion,\n  .vr-accordion * {\n    box-sizing: border-box;\n    font-family: inherit !important;\n  }\n\n  .vr-accordion {\n    width: 100%;\n    max-width: 100%;\n    color: #080808;\n    background: transparent;\n    font-size: 15px;\n    line-height: 1.65;\n  }\n\n  .vr-accordion__item {\n    margin: 0 !important;\n    padding: 0 !important;\n    border: 0 !important;\n    border-bottom: 1px solid #e0e2e8 !important;\n    background: transparent !important;\n  }\n\n  .vr-accordion__heading {\n    display: flex !important;\n    align-items: center;\n    justify-content: space-between;\n    gap: 16px;\n    padding: 17px 10px !important;\n    margin: 0 !important;\n    list-style: none !important;\n    background: transparent !important;\n    color: #080808 !important;\n    font-size: 16px !important;\n    font-weight: 600 !important;\n    line-height: 1.4 !important;\n    cursor: pointer;\n    text-transform: none !important;\n    letter-spacing: normal !important;\n  }\n\n  .vr-accordion__heading::-webkit-details-marker {\n    display: none;\n  }\n\n  .vr-accordion__heading::marker {\n    content: '';\n  }\n\n  .vr-accordion__heading::before,\n  .vr-accordion__heading::after {\n    content: none !important;\n    display: none !important;\n  }\n\n  .vr-accordion__chevron {\n    flex: none;\n    display: block;\n    color: #080808;\n    transition: transform .2s ease;\n  }\n\n  .vr-accordion__item[open] .vr-accordion__chevron {\n    transform: rotate(180deg);\n  }\n\n  .vr-accordion__content {\n    padding: 0 10px 22px !important;\n    margin: 0 !important;\n    color: #080808;\n    font-size: 15px;\n    font-weight: 400;\n    line-height: 1.65;\n    overflow-wrap: break-word;\n  }\n\n  .vr-accordion__content p {\n    margin: 0 0 14px !important;\n    padding: 0 !important;\n    color: inherit;\n    font-size: inherit;\n    line-height: inherit;\n  }\n\n  .vr-accordion__content p:last-child {\n    margin-bottom: 0 !important;\n  }\n\n  .vr-accordion__content strong,\n  .vr-accordion__content b {\n    font-weight: 600 !important;\n  }\n\n  .vr-accordion__rte img,\n  .vr-accordion__rte video,\n  .vr-accordion__rte iframe {\n    max-width: 100%;\n  }\n\n  .vr-accordion__content--size {\n    padding: 10px 10px 18px !important;\n  }\n\n  .vr-accordion__content--size img {\n    display: block;\n    width: 100%;\n    max-width: 406px;\n    height: auto;\n    margin: 0;\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .vr-accordion__chevron {\n      transition: none;\n    }\n  }\n</style>"
