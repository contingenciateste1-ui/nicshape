.vr-story-sculpt__text h2 {\n    margin: 0 0 20px;\n    color: #584c43;\n    font-family: inherit !important;\n    font-size: clamp(26px, 2.65vw, 30px);\n    font-style: normal;\n    font-weight: 700;\n    line-height: 1.2;\n    letter-spacing: 0;\n    text-transform: none;\n  }\n\n  .vr-story-sculpt__text p {\n    margin: 0 0 12px;\n    color: #171717;\n    font-family: inherit !important;\n    font-size: 15.5px;\n    font-weight: 400;\n    line-height: 1.54;\n    letter-spacing: 0;\n    text-transform: none;\n  }\n\n  .vr-story-sculpt__text p:last-child {\n    margin-bottom: 0;\n  }\n\n  /* Em telas lado a lado, imagem a direita e texto a esquerda.\n     No celular permanece a imagem acima do texto. */\n  @media screen and (min-width: 750px) {\n    .vr-story-sculpt__image {\n      grid-column: 2;\n      grid-row: 1;\n    }\n\n    .vr-story-sculpt__text {\n      grid-column: 1;\n      grid-row: 1;\n    }\n  }\n\n  /* Desktop: amplia a secao mesmo dentro de um bloco central estreito do Horizon. */\n  @media screen and (min-width: 990px) {\n    .vr-story-sculpt {\n      position: relative;\n      left: 50%;\n      transform: translateX(-50%);\n      width: min(1320px, calc(100vw - 56px));\n      max-width: none;\n      min-height: 740px;\n      grid-template-columns: minmax(0, 47fr) minmax(0, 53fr);\n      margin: 0;\n    }\n\n    .vr-story-sculpt__image img {\n      min-height: 740px;\n    }\n\n    .vr-story-sculpt__text {\n      padding: 60px clamp(44px, 5vw, 86px);\n    }\n\n    .vr-story-sculpt__text h2 {\n      font-size: clamp(32px, 2.7vw, 38px);\n    }\n\n    .vr-story-sculpt__text p {\n      font-size: 17px;\n      line-height: 1.6;\n    }\n  }\n\n  @media (max-width: 749px) {\n    .vr-story-sculpt {\n      display: flex;\n      flex-direction: column;\n      min-height: 0;\n      border-radius: 14px;\n    }\n\n    .vr-story-sculpt__image {\n      aspect-ratio: 519 / 650;\n    }\n\n    .vr-story-sculpt__image img {\n      width: 100%;\n      height: 100%;\n      min-height: 0;\n    }\n\n    .vr-story-sculpt__text {\n      padding: 28px 24px 32px;\n    }\n\n    .vr-story-sculpt__text h2 {\n      margin-bottom: 18px;\n      font-size: clamp(24px, 6vw, 29px);\n      line-height: 1.23;\n    }\n\n    .vr-story-sculpt__text p {\n      font-size: 15px;\n      line-height: 1.55;\n      margin-bottom: 12px;\n    }\n  }\n</style>"
