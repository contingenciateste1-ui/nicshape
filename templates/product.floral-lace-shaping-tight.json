            "custom_liquid_JWHNMP": {
              "type": "custom-liquid",
              "name": "Selecionador de Variantes",
              "settings": {
                "custom_liquid": "{% comment %}\n  HORIZON — SELETOR VISUAL UNICO | Color + Size\n  1. Colocar no bloco \"Custom Liquid\" em Product details.\n  2. MANTER o bloco nativo \"Variant picker\" ATIVO no mesmo Product details.\n  3. Preferencialmente, configurar o picker nativo como \"Buttons\".\n  4. Apagar os antigos codigos CSS/Custom Liquid das tentativas anteriores.\n  O seletor nativo e ocultado somente depois de confirmar a conexao.\n{% endcomment %}\n\n{% assign hvs_product = closest.product | default: product %}\n{% if hvs_product != blank and hvs_product.has_only_default_variant == false %}\n\n<style>\n  /* Esconde APENAS o componente original ligado a este produto, apos ativar a integracao. */\n  .product-details.hvs2-connected-{{ hvs_product.id }} variant-picker[data-product-id=\"{{ hvs_product.id }}\"] {\n    position: absolute !important;\n    left: -10000px !important;\n    top: auto !important;\n    width: 1px !important;\n    min-width: 0 !important;\n    max-width: 1px !important;\n    height: 1px !important;\n    min-height: 0 !important;\n    margin: 0 !important;\n    padding: 0 !important;\n    border: 0 !important;\n    overflow: hidden !important;\n    clip-path: inset(50%) !important;\n    opacity: 0 !important;\n    pointer-events: none !important;\n  }\n\n  .hvs2-picker {\n    display: block !important;\n    width: 100%;\n    color: #111;\n    font-family: Arial, Helvetica, sans-serif;\n    line-height: 1.4;\n  }\n  .hvs2-picker *, .hvs2-picker *::before, .hvs2-picker *::after { box-sizing: border-box; }\n  .hvs2-picker__group { margin: 0 0 36px; }\n  .hvs2-picker__group:last-child { margin-bottom: 0; }\n  .hvs2-picker__title { font: 400 13px/1.45 Arial, Helvetica, sans-serif; margin: 0 0 13px; }\n  .hvs2-picker__title strong { font-weight: 700; }\n  .hvs2-picker__choices { display: flex; align-items: center; flex-wrap: wrap; }\n  .hvs2-picker__choices--color { gap: 12px; padding: 4px 5px 5px; }\n  .hvs2-picker__color {\n    position: relative;\n    display: inline-flex;\n    width: 32px;\n    height: 32px;\n    min-width: 32px;\n    min-height: 32px;\n    flex: 0 0 32px;\n    align-items: center;\n    justify-content: center;\n    padding: 0;\n    margin: 0;\n    border: 0;\n    border-radius: 50%;\n    appearance: none;\n    -webkit-appearance: none;\n    background: transparent;\n    cursor: pointer;\n  }\n  .hvs2-picker__dot {\n    display: block;\n    width: 32px;\n    height: 32px;\n    border-radius: 50%;\n    border: 1px solid rgba(0,0,0,.12);\n    background-color: var(--hvs2-color, #d0d0d0);\n    background-image: var(--hvs2-swatch-image, none);\n    background-position: center;\n    background-size: cover;\n  }\n  .hvs2-picker__color[aria-pressed=\"true\"]::after {\n    position: absolute;\n    content: \"\";\n    inset: -5px;\n    border: 3px solid #080808;\n    border-radius: 50%;\n    pointer-events: none;\n  }\n  .hvs2-picker__choices--size { gap: 8px; }\n  .hvs2-picker__size {\n    display: inline-flex;\n    min-height: 40px;\n    min-width: 52px;\n    align-items: center;\n    justify-content: center;\n    padding: 0 12px;\n    border: 1px solid #e7e7e7;\n    border-radius: 4px;\n    background: #fff;\n    color: #111;\n    font: 400 13px/1.25 Arial, Helvetica, sans-serif;\n    text-align: center;\n    cursor: pointer;\n    appearance: none;\n    -webkit-appearance: none;\n  }\n  .hvs2-picker__size:hover { border-color: #777; }\n  .hvs2-picker__size[aria-pressed=\"true\"] { background: #292929; color: #fff; border-color: #292929; font-weight: 700; }\n  .hvs2-picker button:focus-visible { outline: 2px solid #4076ba; outline-offset: 5px; }\n  .hvs2-picker button[aria-disabled=\"true\"] { opacity: .55; }\n  .hvs2-picker__message { color: #9b2525; font-size: 12px; margin: 12px 0 0; }\n  .hvs2-picker [hidden] { display: none !important; }\n  @media (max-width: 749px) {\n    .hvs2-picker__choices--size { gap: 7px; }\n    .hvs2-picker__size { min-width: 48px; padding: 0 10px; }\n  }\n</style>\n\n<div class=\"hvs2-picker\" id=\"hvs2-{{ section.id }}-{{ block.id }}\" data-hvs2-product-id=\"{{ hvs_product.id }}\" aria-label=\"Product variants\">\n  {% for hvs_option in hvs_product.options_with_values %}\n    {% assign hvs_name_lower = hvs_option.name | downcase | strip %}\n    {% assign hvs_is_color = false %}\n    {% if hvs_name_lower contains 'color' or hvs_name_lower contains 'colour' or hvs_name_lower contains 'cor' or hvs_name_lower contains 'couleur' or hvs_name_lower contains 'colore' %}\n      {% assign hvs_is_color = true %}\n    {% endif %}\n    <div class=\"hvs2-picker__group\" data-hvs2-option=\"{{ hvs_option.name | escape }}\">\n      <p class=\"hvs2-picker__title\">{{ hvs_option.name | escape }}: <strong data-hvs2-selected>{{ hvs_option.selected_value | escape }}</strong></p>\n      <div class=\"hvs2-picker__choices {% if hvs_is_color %}hvs2-picker__choices--color{% else %}hvs2-picker__choices--size{% endif %}\">\n        {% for hvs_value in hvs_option.values %}\n          {% assign hvs_value_name = hvs_value.name | default: hvs_value %}\n          {% if hvs_is_color %}\n            {% assign hvs_color_name = hvs_value_name | downcase | strip %}\n            {% assign hvs_color_hex = '#cccccc' %}\n            {% case hvs_color_name %}\n              {% when 'black' or 'preto' or 'negro' or 'noir' %}{% assign hvs_color_hex = '#050505' %}\n              {% when 'brown' or 'marrom' or 'marrón' or 'marron' or 'chocolate' %}{% assign hvs_color_hex = '#593b31' %}\n              {% when 'coffee' or 'coffe' %}{% assign hvs_color_hex = '#6F4E37' %}\n              {% when 'beige' or 'nude' or 'sand' or 'arena' or 'areia' %}{% assign hvs_color_hex = '#d4b997' %}\n              {% when 'white' or 'branco' or 'blanco' or 'blanc' %}{% assign hvs_color_hex = '#ffffff' %}\n              {% when 'grey' or 'gray' or 'cinza' or 'gris' %}{% assign hvs_color_hex = '#868686' %}\n              {% when 'navy' or 'navy blue' or 'azul marinho' %}{% assign hvs_color_hex = '#24324e' %}\n              {% when 'blue' or 'azul' or 'bleu' %}{% assign hvs_color_hex = '#416f9d' %}\n              {% when 'green' or 'verde' or 'vert' %}{% assign hvs_color_hex = '#526d50' %}\n              {% when 'red' or 'rojo' or 'vermelho' or 'rouge' %}{% assign hvs_color_hex = '#b33535' %}\n              {% when 'pink' or 'rosa' or 'rose' %}{% assign hvs_color_hex = '#dba7b5' %}\n              {% when 'burgundy' or 'wine' or 'vinho' or 'vino' %}{% assign hvs_color_hex = '#622b3b' %}\n              {% when 'cream' or 'crema' or 'creme' or 'ivory' %}{% assign hvs_color_hex = '#f0e6d3' %}\n              {% when 'olive' or 'oliva' %}{% assign hvs_color_hex = '#74744a' %}\n              {% when 'camel' %}{% assign hvs_color_hex = '#b89161' %}\n              {% when 'khaki' or 'caqui' %}{% assign hvs_color_hex = '#afa381' %}\n            {% endcase %}\n            {% if hvs_value.swatch.color != blank %}{% assign hvs_color_hex = hvs_value.swatch.color %}{% endif %}\n            {% if hvs_color_name == 'chocolate' %}{% assign hvs_color_hex = '#895947' %}{% endif %}\n            <button type=\"button\" class=\"hvs2-picker__color\" data-hvs2-value=\"{{ hvs_value_name | escape }}\"\n              title=\"{{ hvs_value_name | escape }}\" aria-label=\"{{ hvs_option.name | escape }}: {{ hvs_value_name | escape }}\"\n              aria-pressed=\"{% if hvs_value.selected %}true{% else %}false{% endif %}\"\n              style=\"--hvs2-color:{{ hvs_color_hex }};{% if hvs_value.swatch.image != blank %}--hvs2-swatch-image:url('{{ hvs_value.swatch.image | image_url: width: 80 }}');{% endif %}\">\n              <span class=\"hvs2-picker__dot\" aria-hidden=\"true\"></span>\n            </button>\n          {% else %}\n            <button type=\"button\" class=\"hvs2-picker__size\" data-hvs2-value=\"{{ hvs_value_name | escape }}\"\n              aria-pressed=\"{% if hvs_value.selected %}true{% else %}false{% endif %}\">{{ hvs_value_name | escape }}</button>\n          {% endif %}\n        {% endfor %}\n      </div>\n    </div>\n  {% endfor %}\n  <p class=\"hvs2-picker__message\" data-hvs2-message role=\"status\" hidden></p>\n</div>\n\n<script>\n(function () {\n  const root = document.getElementById('hvs2-{{ section.id }}-{{ block.id }}');\n  if (!root || root.dataset.hvs2Bound === 'true') return;\n  root.dataset.hvs2Bound = 'true';\n  const productId = root.dataset.hvs2ProductId;\n  const details = root.closest('.product-details');\n  const message = root.querySelector('[data-hvs2-message]');\n  if (!details) return;\n\n  let picker = null;\n  let queued = false;\n  let pickerObserver = null;\n\n  function locatePicker() {\n    const candidates = Array.from(details.querySelectorAll('variant-picker'));\n    return candidates.find(el => el.dataset.productId === productId) || null;\n  }\n  function nativeOption(name, value) {\n    if (!picker) return null;\n    const radio = Array.from(picker.querySelectorAll('input[type=\"radio\"][data-option-name]'))\n      .find(el => el.dataset.optionName === name && el.value === value);\n    if (radio) return { kind: 'radio', el: radio };\n    const select = Array.from(picker.querySelectorAll('select'))\n      .find(el => Array.from(el.options).some(o => o.dataset.optionName === name && o.value === value));\n    return select ? { kind: 'select', el: select } : null;\n  }\n  function selectedValue(name) {\n    if (!picker) return null;\n    const checked = Array.from(picker.querySelectorAll('input[type=\"radio\"][data-option-name]:checked'))\n      .find(el => el.dataset.optionName === name);\n    if (checked) return checked.value;\n    const selects = Array.from(picker.querySelectorAll('select'));\n    const select = selects.find(el => Array.from(el.options).some(o => o.dataset.optionName === name));\n    return select ? select.value : null;\n  }\n  function sync() {\n    queued = false;\n    if (!root.isConnected) return;\n    if (!picker || !picker.isConnected) {\n      if (!connect()) return;\n    }\n    root.querySelectorAll('[data-hvs2-option]').forEach(group => {\n      const name = group.dataset.hvs2Option;\n      const chosen = selectedValue(name);\n      if (chosen == null) return;\n      const heading = group.querySelector('[data-hvs2-selected]');\n      if (heading && heading.textContent !== chosen) heading.textContent = chosen;\n      group.querySelectorAll('button[data-hvs2-value]').forEach(button => {\n        const nextPressed = String(button.dataset.hvs2Value === chosen);\n        if (button.getAttribute('aria-pressed') !== nextPressed) button.setAttribute('aria-pressed', nextPressed);\n        const target = nativeOption(name, button.dataset.hvs2Value);\n        if (target && target.kind === 'radio') {\n          const nextDisabled = String(target.el.getAttribute('aria-disabled') === 'true');\n          if (button.getAttribute('aria-disabled') !== nextDisabled) button.setAttribute('aria-disabled', nextDisabled);\n        } else if (target) {\n          const option = Array.from(target.el.options).find(o => o.value === button.dataset.hvs2Value);\n          const nextDisabled = String(Boolean(option && option.disabled));\n          if (button.getAttribute('aria-disabled') !== nextDisabled) button.setAttribute('aria-disabled', nextDisabled);\n        }\n      });\n    });\n  }\n  function scheduleSync() {\n    if (queued) return;\n    queued = true;\n    requestAnimationFrame(sync);\n  }\n  function connect() {\n    const found = locatePicker();\n    if (!found) {\n      details.classList.remove('hvs2-connected-' + productId);\n      picker = null;\n      return false;\n    }\n    if (picker !== found) {\n      pickerObserver?.disconnect();\n      picker = found;\n      pickerObserver = new MutationObserver(scheduleSync);\n      pickerObserver.observe(picker, {\n        childList: true, subtree: true, attributes: true,\n        attributeFilter: ['checked', 'selected', 'data-current-checked', 'aria-disabled', 'data-option-available']\n      });\n    }\n    details.classList.add('hvs2-connected-' + productId);\n    return true;\n  }\n\n  root.addEventListener('click', function(event) {\n    const button = event.target.closest('button[data-hvs2-value]');\n    if (!button || !root.contains(button)) return;\n    if (!connect()) {\n      message.textContent = 'Variant picker do Horizon não encontrado. Mantenha o bloco nativo ativo.';\n      message.hidden = false;\n      return;\n    }\n    const group = button.closest('[data-hvs2-option]');\n    const name = group?.dataset.hvs2Option;\n    const value = button.dataset.hvs2Value;\n    const target = nativeOption(name, value);\n    if (!target && group.querySelectorAll('button[data-hvs2-value]').length === 1) {\n      // Horizon renderiza opcoes com valor unico como texto, sem input.\n      message.hidden = true;\n      return;\n    }\n    if (!target) {\n      message.textContent = 'Esta opção não está disponível no seletor nativo: ' + value;\n      message.hidden = false;\n      return;\n    }\n    message.hidden = true;\n    if (target.kind === 'radio') {\n      if (!target.el.checked) {\n        target.el.checked = true;\n        target.el.dispatchEvent(new Event('change', { bubbles: true }));\n      }\n    } else if (target.el.value !== value) {\n      target.el.value = value;\n      target.el.dispatchEvent(new Event('change', { bubbles: true }));\n    }\n    // Atualiza visual imediatamente, depois sincroniza quando o Horizon atualizar o picker.\n    const currentLabel = group.querySelector('[data-hvs2-selected]');\n    if (currentLabel && currentLabel.textContent !== value) currentLabel.textContent = value;\n    group.querySelectorAll('button[data-hvs2-value]').forEach(b =>\n      b.setAttribute('aria-pressed', String(b.dataset.hvs2Value === value))\n    );\n    scheduleSync();\n  });\n\n  details.addEventListener('change', function (event) {\n    if (event.target.closest('variant-picker')) scheduleSync();\n  });\n  document.addEventListener('variant:update', scheduleSync);\n  document.addEventListener('shopify:section:load', scheduleSync);\n\n  // O Horizon substitui inputs por AJAX apos alterar uma variante.\n  // Observa a substituicao para manter o picker original oculto e atualizado.\n  const detailsObserver = new MutationObserver(function () {\n    if (locatePicker() !== picker) connect();\n    scheduleSync();\n  });\n  detailsObserver.observe(details, { childList: true, subtree: true });\n\n  if (connect()) sync();\n  else {\n    // Se o bloco nativo vier depois no DOM, tenta novamente quando a pagina terminar de carregar.\n    document.addEventListener('DOMContentLoaded', function () { connect(); sync(); }, { once: true });\n  }\n})();\n</script>\n{% endif %}"
              },
              "blocks": {}
            },
