            "custom_liquid_R3hth4": {
              "type": "custom-liquid",
              "name": "Carrossel Clientes",
              "settings": {
                "custom_liquid": "{% comment %}\n  HORIZON | Carrossel de 6 videos de clientes\n  COLE ESTE CODIGO EM UM BLOCO CUSTOM LIQUID.\n  Substitua somente os 6 valores src=\"COLE_AQUI_...\" pelas URLs diretas\n  dos arquivos MP4 enviados em Shopify > Conteudo > Arquivos.\n  Sem setas, sem bolinhas e sem movimento automatico do carrossel.\n{% endcomment %}\n\n<section class=\"vr-ugc-reviews\" data-vr-ugc-reviews aria-label=\"Customer videos\">\n  <h2 class=\"vr-ugc-reviews__title\">Loved by 25,000+ women</h2>\n\n  <div class=\"vr-ugc-reviews__track\" data-vr-ugc-track tabindex=\"0\" aria-label=\"Drag or swipe to see more customer videos\">\n\n    <!-- VIDEO 1: TROQUE SOMENTE O LINK DO SRC -->\n    <div class=\"vr-ugc-reviews__item\">\n      <video src=\"https://cdn.shopify.com/videos/c/o/v/bef9759b0c2e4736a47242f6d15d59e0.mp4\" autoplay muted loop playsinline preload=\"metadata\" aria-label=\"Customer video 1\"></video>\n    </div>\n\n    <!-- VIDEO 2: TROQUE SOMENTE O LINK DO SRC -->\n    <div class=\"vr-ugc-reviews__item\">\n      <video src=\"https://cdn.shopify.com/videos/c/o/v/b93f58b69c4241fc92513639e8d6c5f7.mp4\" autoplay muted loop playsinline preload=\"metadata\" aria-label=\"Customer video 2\"></video>\n    </div>\n\n    <!-- VIDEO 3: TROQUE SOMENTE O LINK DO SRC -->\n    <div class=\"vr-ugc-reviews__item\">\n      <video src=\"https://cdn.shopify.com/videos/c/o/v/4dc99518c08641f3a98c146a12bf7c4f.mp4\" autoplay muted loop playsinline preload=\"metadata\" aria-label=\"Customer video 3\"></video>\n    </div>\n\n    <!-- VIDEO 4: TROQUE SOMENTE O LINK DO SRC -->\n    <div class=\"vr-ugc-reviews__item\">\n      <video src=\"https://cdn.shopify.com/videos/c/o/v/e17b272b42a54be1ab274aa76ded2acb.mp4\" autoplay muted loop playsinline preload=\"metadata\" aria-label=\"Customer video 4\"></video>\n    </div>\n\n    <!-- VIDEO 5: TROQUE SOMENTE O LINK DO SRC -->\n    <div class=\"vr-ugc-reviews__item\">\n      <video src=\"https://cdn.shopify.com/videos/c/o/v/a5b8dba10cae4a5da9460c44aad165b8.mp4\" autoplay muted loop playsinline preload=\"metadata\" aria-label=\"Customer video 5\"></video>\n    </div>\n\n    <!-- VIDEO 6: TROQUE SOMENTE O LINK DO SRC -->\n    <div class=\"vr-ugc-reviews__item\">\n      <video src=\"https://cdn.shopify.com/videos/c/o/v/e1d5ec31f2c04edfa155303265b0a466.mp4\" autoplay muted loop playsinline preload=\"metadata\" aria-label=\"Customer video 6\"></video>\n    </div>\n\n  </div>\n</section>\n\n<style>\n  /* Poppins apenas nesta secao, sem mudar a fonte da loja inteira. */\n  @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap');\n\n  .vr-ugc-reviews,\n  .vr-ugc-reviews * { box-sizing: border-box; }\n\n  .vr-ugc-reviews {\n    width: 100%;\n    max-width: 100%;\n    min-width: 0;\n    margin: 0 auto;\n    padding: 0;\n    overflow: hidden;\n    font-family: 'Poppins', sans-serif;\n    color: #111;\n  }\n\n  .vr-ugc-reviews__title {\n    font-family: 'Poppins', sans-serif !important;\n    color: #111;\n    text-align: center;\n    font-size: 18px;\n    font-weight: 700;\n    line-height: 1.35;\n    letter-spacing: -0.02em;\n    text-transform: none;\n    margin: 0 0 13px;\n    padding: 0 4px;\n  }\n\n  .vr-ugc-reviews__track {\n    display: flex;\n    align-items: stretch;\n    gap: 8px;\n    width: 100%;\n    min-width: 0;\n    padding: 0 0 2px;\n    margin: 0;\n    overflow-x: auto;\n    overflow-y: hidden;\n    scroll-snap-type: x proximity;\n    scrollbar-width: none;\n    -ms-overflow-style: none;\n    -webkit-overflow-scrolling: touch;\n    overscroll-behavior-x: contain;\n    cursor: grab;\n    user-select: none;\n    -webkit-user-select: none;\n  }\n\n  .vr-ugc-reviews__track::-webkit-scrollbar { display: none; }\n  .vr-ugc-reviews__track.is-dragging { cursor: grabbing; scroll-snap-type: none; }\n  .vr-ugc-reviews__track:focus-visible { outline: 2px solid #333; outline-offset: -2px; }\n\n  /* Desktop: videos pequenos para caberem sob o accordion de produto. */\n  .vr-ugc-reviews__item {\n    flex: 0 0 21%;\n    min-width: 0;\n    aspect-ratio: 9 / 16;\n    overflow: hidden;\n    position: relative;\n    border-radius: 11px;\n    background: #eee9e5;\n    scroll-snap-align: start;\n  }\n\n  .vr-ugc-reviews__item video {\n    display: block;\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    object-position: center;\n    border: 0;\n    border-radius: inherit;\n    pointer-events: none;\n  }\n\n  /* Celular: videos maiores e parte do proximo visivel. */\n  @media screen and (max-width: 749px) {\n    .vr-ugc-reviews__title {\n      font-size: 21px;\n      margin-bottom: 17px;\n    }\n    .vr-ugc-reviews__track { gap: 8px; }\n    .vr-ugc-reviews__item {\n      flex: 0 0 clamp(126px, 37vw, 165px);\n      border-radius: 12px;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .vr-ugc-reviews__track { scroll-snap-type: none; }\n  }\n</style>\n\n<script>\n(function () {\n  function initVrVideos() {\n    document.querySelectorAll('[data-vr-ugc-reviews]:not([data-vr-ugc-ready])').forEach(function(section) {\n      section.setAttribute('data-vr-ugc-ready', 'true');\n      var track = section.querySelector('[data-vr-ugc-track]');\n      if (!track) return;\n\n      // Arraste com mouse no desktop. No celular, o swipe e nativo.\n      var down = false;\n      var startX = 0;\n      var startScroll = 0;\n      var pointerId = null;\n\n      track.addEventListener('pointerdown', function(e) {\n        if (e.pointerType !== 'mouse' || e.button !== 0) return;\n        down = true;\n        pointerId = e.pointerId;\n        startX = e.clientX;\n        startScroll = track.scrollLeft;\n        track.classList.add('is-dragging');\n        track.setPointerCapture(e.pointerId);\n      });\n\n      track.addEventListener('pointermove', function(e) {\n        if (!down || e.pointerId !== pointerId) return;\n        track.scrollLeft = startScroll - (e.clientX - startX);\n      });\n\n      function stopDrag() {\n        down = false;\n        pointerId = null;\n        track.classList.remove('is-dragging');\n      }\n      track.addEventListener('pointerup', stopDrag);\n      track.addEventListener('pointercancel', stopDrag);\n      track.addEventListener('lostpointercapture', stopDrag);\n\n      // Evita tocar videos escondidos: reproduz apenas os visiveis.\n      if ('IntersectionObserver' in window) {\n        var observer = new IntersectionObserver(function(entries) {\n          entries.forEach(function(entry) {\n            var video = entry.target;\n            if (entry.isIntersecting) {\n              video.muted = true;\n              var attempt = video.play();\n              if (attempt && typeof attempt.catch === 'function') attempt.catch(function() {});\n            } else {\n              video.pause();\n            }\n          });\n        }, { threshold: 0.25 });\n        section.querySelectorAll('video').forEach(function(video) { observer.observe(video); });\n      }\n    });\n  }\n\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', initVrVideos, { once: true });\n  } else {\n    initVrVideos();\n  }\n  document.addEventListener('shopify:section:load', initVrVideos);\n})();\n</script>"
