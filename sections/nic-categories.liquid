{% render 'nic-button-styles' %}

<section
  class="nic-cats"
  style="
    --cats-bg: {{ section.settings.bg_color }};
    --cats-fg: {{ section.settings.text_color }};
    --cats-cols: {{ section.settings.columns_desktop }};
  "
>
  {%- if section.settings.heading != blank -%}
    <h2 class="nic-heading">{{ section.settings.heading }}</h2>
  {%- endif -%}

  <ul class="nic-cats__list">
    {%- for block in section.blocks -%}
      <li class="nic-cats__item" {{ block.shopify_attributes }}>
        <a class="nic-cats__link" href="{{ block.settings.link | default: routes.all_products_collection_url }}">
          <span class="nic-cats__media">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 480
                | image_tag: loading: 'lazy', widths: '200, 320, 480', sizes: '(min-width: 750px) 15vw, 160px'
              }}
            {%- else -%}
              {{ 'collection-' | append: forloop.index | placeholder_svg_tag: 'nic-placeholder' }}
            {%- endif -%}
          </span>
          <span class="nic-cats__title">
            {{- block.settings.title -}}
            {%- if block.settings.subtitle != blank -%}
              <small>{{ block.settings.subtitle }}</small>
            {%- endif -%}
          </span>
        </a>
      </li>
    {%- endfor -%}
  </ul>
</section>

{% stylesheet %}
  .nic-cats {
    padding: 36px 0 28px;
    background: var(--cats-bg);
    color: var(--cats-fg);
    font-family: var(--font-body--family);
  }

  .nic-cats .nic-heading {
    padding-inline: 16px;
    margin-bottom: 20px;
  }

  .nic-cats__list {
    display: flex;
    gap: 12px;
    margin: 0;
    padding: 0 16px 8px;
    overflow-x: auto;
    list-style: none;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
  }

  .nic-cats__list::-webkit-scrollbar {
    display: none;
  }

  .nic-cats__item {
    flex: 0 0 160px;
    scroll-snap-align: start;
  }

  .nic-cats__link {
    display: flex;
    flex-direction: column;
    gap: 10px;
    color: inherit;
    text-decoration: none;
  }

  .nic-cats__media {
    display: block;
    aspect-ratio: 129 / 184;
    overflow: hidden;
    border-radius: 12px;
    background: #f3e7e2;
  }

  .nic-cats__media img,
  .nic-cats__media svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .nic-cats__link:hover .nic-cats__media img {
    transform: scale(1.04);
  }

  .nic-cats__title {
    font-size: 0.9375rem;
    font-weight: 700;
    text-align: center;
  }

  .nic-cats__title small {
    display: block;
    margin-top: 2px;
    font-size: 0.75rem;
    font-weight: 500;
    color: #c2685b;
  }

  @media screen and (min-width: 750px) {
    .nic-cats__list {
      display: grid;
      grid-template-columns: repeat(var(--cats-cols), minmax(0, 1fr));
      gap: 20px;
      max-width: 1400px;
      margin-inline: auto;
      padding-inline: 32px;
      overflow: visible;
    }

    .nic-cats__item {
      flex: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Nicshape categories",
  "tag": "section",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop shapewear, bras & everyday essentials" },
    { "type": "range", "id": "columns_desktop", "label": "Columns (desktop)", "min": 3, "max": 8, "step": 1, "default": 6 },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#2b2224" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Recommended 129:184 (portrait)." },
        { "type": "text", "id": "title", "label": "Title", "default": "Category" },
        { "type": "text", "id": "subtitle", "label": "Subtitle (optional)" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Nicshape categories",
      "blocks": [
        { "type": "category", "settings": { "title": "New" } },
        { "type": "category", "settings": { "title": "Best sellers" } },
        { "type": "category", "settings": { "title": "Bras" } },
        { "type": "category", "settings": { "title": "Bodysuits" } },
        { "type": "category", "settings": { "title": "Shapers" } },
        { "type": "category", "settings": { "title": "Swimwear" } }
      ]
    }
  ]
}
{% endschema %}
