{%- liquid
  assign heading = section.settings.heading
-%}

{%- comment -%}nic-hide-empty{%- endcomment -%}
{%- if section.blocks.size > 0 or request.design_mode -%}
<section
  class="nic-strip"
  style="
    --strip-bg: {{ section.settings.bg_color }};
    --strip-heading: {{ section.settings.heading_color }};
    --strip-title: {{ section.settings.title_color }};
    --strip-n-d: {{ section.settings.cards_desktop }};
    --strip-n-m: {{ section.settings.cards_mobile }};
    --strip-active: {{ section.settings.active_color }};
    --strip-radius: {{ section.settings.card_radius }}px;
    --strip-title-weight: {{ section.settings.title_weight }};
    --strip-gap-d: {{ section.settings.gap_desktop }}px;
    --strip-pt-d: {{ section.settings.padding_top_desktop }}px;
    --strip-pb-d: {{ section.settings.padding_bottom_desktop }}px;
    --strip-pt-m: {{ section.settings.padding_top_mobile }}px;
    --strip-pb-m: {{ section.settings.padding_bottom_mobile }}px;
  "
>
  {%- if heading != blank -%}
    <h2 class="nic-strip__heading">{{ heading }}</h2>
  {%- endif -%}

  {%- if section.blocks.size == 0 -%}
    {%- if request.design_mode -%}<p class="nic-strip__empty">Add “Collection card” blocks.</p>{%- endif -%}
  {%- endif -%}

  <ul class="nic-strip__row" tabindex="0" aria-label="{{ heading | escape }}">
    {%- for block in section.blocks -%}
      <li class="nic-strip__item" {{ block.shopify_attributes }}>
        {%- assign card_url = block.settings.link | default: routes.all_products_collection_url -%}
        {%- assign is_active = false -%}
        {%- if section.settings.highlight_active and collection.url != blank and card_url == collection.url -%}
          {%- assign is_active = true -%}
        {%- endif -%}
        <a class="nic-strip__link{% if is_active %} is-active{% endif %}" href="{{ card_url }}"{% if is_active %} aria-current="page"{% endif %}>
          <span class="nic-strip__media">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 560
                | image_tag:
                  loading: 'lazy',
                  widths: '220, 320, 440, 560',
                  sizes: '(min-width: 750px) 14vw, 42vw',
                  alt: block.settings.title
              }}
            {%- else -%}
              {{ 'collection-' | append: forloop.index | placeholder_svg_tag: 'nic-strip__placeholder' }}
            {%- endif -%}
          </span>
          {%- if block.settings.title != blank -%}
            <span class="nic-strip__title">{{ block.settings.title }}</span>
          {%- endif -%}
        </a>
      </li>
    {%- endfor -%}
  </ul>
</section>
{%- endif -%}

{% stylesheet %}
  .nic-strip {
    padding-top: var(--strip-pt-m);
    padding-bottom: var(--strip-pb-m);
    background: var(--strip-bg);
    font-family: var(--font-body--family);
  }

  .nic-strip__heading {
    margin: 0 0 20px;
    padding-inline: 16px;
    color: var(--strip-heading);
    font-family: var(--font-heading--family);
    font-size: clamp(1.5rem, 1.1rem + 1.6vw, 2.25rem);
    font-weight: 700;
    line-height: 1.2;
    text-align: center;
  }

  .nic-strip__empty {
    padding: 24px;
    text-align: center;
    opacity: 0.6;
  }

  .nic-strip__row {
    display: flex;
    gap: 12px;
    margin: 0;
    padding: 0 16px 4px;
    overflow-x: auto;
    list-style: none;
    scroll-snap-type: x proximity;
    scroll-padding-inline: 16px;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .nic-strip__row::-webkit-scrollbar {
    display: none;
  }

  .nic-strip__row:focus-visible {
    outline: 2px solid currentcolor;
    outline-offset: 2px;
  }

  .nic-strip__item {
    flex: 0 0 calc((100% - 12px * (var(--strip-n-m) - 1)) / var(--strip-n-m));
    min-width: 0;
    scroll-snap-align: start;
  }

  .nic-strip__link {
    display: flex;
    flex-direction: column;
    gap: 14px;
    color: var(--strip-title);
    text-decoration: none;
  }

  .nic-strip__link:focus-visible {
    outline: 2px solid currentcolor;
    outline-offset: 4px;
    border-radius: 14px;
  }

  .nic-strip__media {
    display: block;
    aspect-ratio: 129 / 184;
    overflow: hidden;
    border-radius: var(--strip-radius);
    background: #f1efee;
  }

  .nic-strip__media img,
  .nic-strip__media svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .nic-strip__placeholder {
    fill: #c9c2be;
    background: #f1efee;
  }

  .nic-strip__link.is-active .nic-strip__title {
    color: var(--strip-active);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }

  .nic-strip__title {
    font-size: 0.9375rem;
    font-weight: var(--strip-title-weight);
    line-height: 1.3;
    text-align: center;
    text-decoration: none;
  }

  @media (hover: hover) {
    .nic-strip__link:hover .nic-strip__media img {
      transform: scale(1.04);
    }
  }

  @media screen and (min-width: 750px) {
    .nic-strip {
      padding-top: var(--strip-pt-d);
      padding-bottom: var(--strip-pb-d);
    }

    .nic-strip__heading {
      margin-bottom: 32px;
    }

    .nic-strip__row {
      gap: var(--strip-gap-d);
      padding-inline: 32px;
      scroll-padding-inline: 32px;
    }

    .nic-strip__item {
      flex-basis: calc((100% - var(--strip-gap-d) * (var(--strip-n-d) - 1)) / var(--strip-n-d));
    }

    .nic-strip__title {
      font-size: 1.0625rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Nicshape collection strip",
  "tag": "section",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop Shapewear, Bras & Everyday Essentials" },
    { "type": "header", "content": "Cards" },
    {
      "type": "select",
      "id": "cards_desktop",
      "label": "Cards visible (desktop)",
      "info": "A value ending in .4 shows part of the next card, so it is clear the row scrolls.",
      "options": [
        { "value": "4.4", "label": "4 + a peek" },
        { "value": "5.4", "label": "5 + a peek" },
        { "value": "6.4", "label": "6 + a peek" },
        { "value": "7.4", "label": "7 + a peek" },
        { "value": "8.4", "label": "8 + a peek" },
        { "value": "10.4", "label": "10 + a peek" }
      ],
      "default": "7.4"
    },
    {
      "type": "select",
      "id": "cards_mobile",
      "label": "Cards visible (mobile)",
      "options": [
        { "value": "1.5", "label": "1.5" },
        { "value": "2.3", "label": "2.3" },
        { "value": "2.5", "label": "2.5" },
        { "value": "3.3", "label": "3.3" },
        { "value": "4.2", "label": "4.2" }
      ],
      "default": "2.3"
    },
    { "type": "range", "id": "card_radius", "label": "Image roundness", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 14 },
    {
      "type": "select",
      "id": "title_weight",
      "label": "Title weight",
      "options": [
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra bold" }
      ],
      "default": "600"
    },
    { "type": "checkbox", "id": "highlight_active", "label": "Highlight the current collection", "info": "Underlines the card whose link matches the collection page being viewed.", "default": false },
    { "type": "color", "id": "active_color", "label": "Highlight color", "default": "#c0504d" },
    { "type": "range", "id": "gap_desktop", "label": "Gap (desktop)", "min": 12, "max": 64, "step": 4, "unit": "px", "default": 48 },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top_desktop", "label": "Top (desktop)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom_desktop", "label": "Bottom (desktop)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_top_mobile", "label": "Top (mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Bottom (mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 32 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#2b2224" },
    { "type": "color", "id": "title_color", "label": "Card title", "default": "#2b2224" }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Collection card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Portrait, ratio 129:184." },
        { "type": "text", "id": "title", "label": "Title", "default": "Collection" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Nicshape collection strip",
      "blocks": [
        { "type": "collection_card", "settings": { "title": "Shop Sale" } },
        { "type": "collection_card", "settings": { "title": "New" } },
        { "type": "collection_card", "settings": { "title": "Best Sellers" } },
        { "type": "collection_card", "settings": { "title": "Bras" } },
        { "type": "collection_card", "settings": { "title": "Bodysuits" } },
        { "type": "collection_card", "settings": { "title": "Shapers" } },
        { "type": "collection_card", "settings": { "title": "Swimwear" } },
        { "type": "collection_card", "settings": { "title": "Leggings" } }
      ]
    }
  ]
}
{% endschema %}
