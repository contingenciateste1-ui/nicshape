<section
  class="nic-faq"
  id="nic-faq-{{ section.id }}"
  data-one-open="{{ section.settings.one_open }}"
  style="
    --fq-mt: {{ section.settings.margin_top }}px;
    --fq-mb: {{ section.settings.margin_bottom }}px;
    --fq-mt-m: {{ section.settings.margin_top_mobile }}px;
    --fq-mb-m: {{ section.settings.margin_bottom_mobile }}px;
    --fq-py: {{ section.settings.padding_y }}px;
    --fq-px: {{ section.settings.padding_x }}px;
    --fq-py-m: {{ section.settings.padding_y_mobile }}px;
    --fq-px-m: {{ section.settings.padding_x_mobile }}px;
    --fq-bg: {{ section.settings.bg_color }};
    --fq-text: {{ section.settings.text_color }};
    --fq-q: {{ section.settings.question_color }};
    --fq-line: {{ section.settings.divider_color }};
    --fq-eyebrow: {{ section.settings.eyebrow_size }}px;
    --fq-title: {{ section.settings.title_size }}px;
    --fq-title-m: {{ section.settings.title_size_mobile }}px;
    --fq-sub: {{ section.settings.subtitle_size }}px;
    --fq-qs: {{ section.settings.question_size }}px;
    --fq-as: {{ section.settings.answer_size }}px;
  "
>
  <div class="nic-faq__inner">
    <div class="nic-faq__heading">
      {%- if section.settings.eyebrow != blank -%}<p class="nic-faq__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.title != blank -%}<h2 class="nic-faq__title">{{ section.settings.title }}</h2>{%- endif -%}
      {%- if section.settings.subtitle != blank -%}<p class="nic-faq__sub">{{ section.settings.subtitle }}</p>{%- endif -%}
    </div>

    <div class="nic-faq__list">
      {%- for block in section.blocks -%}
        <details class="nic-faq__item"{% if block.settings.open or section.settings.open_first and forloop.first %} open{% endif %} {{ block.shopify_attributes }}>
          <summary class="nic-faq__q">
            <span class="nic-faq__q-text">{{ block.settings.question }}</span>
            <span class="nic-faq__q-icon" aria-hidden="true">
              <svg viewBox="0 0 256 256" width="20" height="20" fill="currentColor"><path d="M213.66,101.66l-80,80a8,8,0,0,1-11.32,0l-80-80A8,8,0,0,1,53.66,90.34L128,164.69l74.34-74.35a8,8,0,0,1,11.32,11.32Z"/></svg>
            </span>
          </summary>
          <div class="nic-faq__a rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('nic-faq-{{ section.id }}');
    if (!root || root.dataset.oneOpen !== 'true') return;
    root.addEventListener('toggle', function (e) {
      var el = e.target;
      if (!el.open) return;
      root.querySelectorAll('details[open]').forEach(function (d) {
        if (d !== el) d.open = false;
      });
    }, true);
  })();
</script>

{% stylesheet %}
  .nic-faq {
    margin: var(--fq-mt-m) 0 var(--fq-mb-m);
    padding: var(--fq-py-m) var(--fq-px-m);
    background: var(--fq-bg);
    color: var(--fq-text);
    font-family: var(--font-body--family);
  }

  .nic-faq__inner {
    max-width: 900px;
    margin: 0 auto;
  }

  .nic-faq__heading {
    margin-bottom: 28px;
    text-align: center;
  }

  .nic-faq__eyebrow {
    margin: 0 0 8px;
    font-size: var(--fq-eyebrow);
    font-weight: 700;
  }

  .nic-faq__title {
    margin: 0 0 10px;
    color: var(--fq-text);
    font-family: var(--font-heading--family);
    font-size: var(--fq-title-m);
    line-height: 1.15;
  }

  .nic-faq__sub {
    margin: 0;
    font-size: var(--fq-sub);
  }

  .nic-faq__item {
    border-bottom: 1px solid var(--fq-line);
  }

  .nic-faq__item:first-child {
    border-top: 1px solid var(--fq-line);
  }

  .nic-faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 0;
    color: var(--fq-q);
    font-size: var(--fq-qs);
    font-weight: 600;
    line-height: 1.4;
    cursor: pointer;
    list-style: none;
  }

  .nic-faq__q::-webkit-details-marker {
    display: none;
  }

  .nic-faq__q-icon {
    display: inline-flex;
    flex: 0 0 auto;
    transition: transform 0.2s ease;
  }

  .nic-faq__item[open] .nic-faq__q-icon {
    transform: rotate(180deg);
  }

  .nic-faq__a {
    padding: 0 0 18px;
    font-size: var(--fq-as);
    line-height: 1.7;
  }

  .nic-faq__a p {
    margin: 0 0 10px;
  }

  .nic-faq__a a {
    color: inherit;
    text-decoration: underline;
  }

  @media screen and (min-width: 750px) {
    .nic-faq {
      margin: var(--fq-mt) 0 var(--fq-mb);
      padding: var(--fq-py) var(--fq-px);
    }

    .nic-faq__title {
      font-size: var(--fq-title);
    }
  }
{% endstylesheet %}

