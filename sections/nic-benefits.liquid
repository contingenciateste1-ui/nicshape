{% render 'nic-button-styles' %}

<section
  class="nic-benefits"
  style="--ben-bg: {{ section.settings.bg_color }}; --ben-fg: {{ section.settings.text_color }}; --ben-accent: {{ section.settings.accent_color }};"
>
  <ul class="nic-benefits__list">
    {%- for block in section.blocks -%}
      <li class="nic-benefit" {{ block.shopify_attributes }}>
        <svg class="nic-benefit__icon" viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          {%- case block.settings.icon -%}
            {%- when 'truck' -%}
              <path d="M3 7h11v9H3z"/><path d="M14 10h4l3 3v3h-7z"/><circle cx="7.5" cy="17.5" r="1.8"/><circle cx="17.5" cy="17.5" r="1.8"/>
            {%- when 'return' -%}
              <path d="M4 12a8 8 0 1 0 3-6.2"/><path d="M4 4v4h4"/>
            {%- when 'swap' -%}
              <path d="M5 8h13l-3-3"/><path d="M19 16H6l3 3"/>
            {%- when 'lock' -%}
              <rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/>
            {%- when 'heart' -%}
              <path d="M12 20s-7-4.5-7-10a4 4 0 0 1 7-2.5A4 4 0 0 1 19 10c0 5.5-7 10-7 10z"/>
            {%- when 'star' -%}
              <path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9z"/>
          {%- endcase -%}
        </svg>
        <span class="nic-benefit__title">{{ block.settings.title }}</span>
        {%- if block.settings.text != blank -%}
          <span class="nic-benefit__text">{{ block.settings.text }}</span>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</section>

{% stylesheet %}
  .nic-benefits {
    padding: 28px 16px;
    background: var(--ben-bg);
    color: var(--ben-fg);
    font-family: var(--font-body--family);
  }

  .nic-benefits__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px 12px;
    max-width: 1100px;
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }

  .nic-benefit {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    text-align: center;
  }

  .nic-benefit__icon {
    color: var(--ben-accent);
  }

  .nic-benefit__title {
    font-size: 0.875rem;
    font-weight: 700;
  }

  .nic-benefit__text {
    font-size: 0.75rem;
    opacity: 0.7;
  }

  @media screen and (min-width: 750px) {
    .nic-benefits__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Nicshape benefits",
  "tag": "section",
  "max_blocks": 6,
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#2b2224" },
    { "type": "color", "id": "accent_color", "label": "Icon color", "default": "#c98e86" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "truck", "label": "Delivery" },
            { "value": "return", "label": "Returns" },
            { "value": "swap", "label": "Exchange" },
            { "value": "lock", "label": "Secure payment" },
            { "value": "heart", "label": "Heart" },
            { "value": "star", "label": "Star" }
          ],
          "default": "truck"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Free shipping" },
        { "type": "text", "id": "text", "label": "Text (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Nicshape benefits",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "truck", "title": "Free shipping" } },
        { "type": "benefit", "settings": { "icon": "return", "title": "Easy returns" } },
        { "type": "benefit", "settings": { "icon": "swap", "title": "Free size exchange" } },
        { "type": "benefit", "settings": { "icon": "lock", "title": "Secure payments" } }
      ]
    }
  ]
}
{% endschema %}
