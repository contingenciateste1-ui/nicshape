{% render 'nic-button-styles' %}

<section
  class="nic-hero nic-hero--{{ section.settings.image_side }}"
  style="
    --hero-bg: {{ section.settings.bg_color }};
    --hero-fg: {{ section.settings.text_color }};
    --hero-accent: {{ section.settings.accent_color }};
    --hero-min-h: {{ section.settings.min_height }}px;
  "
>
  <div class="nic-hero__media">
    {%- if section.settings.image != blank -%}
      <picture>
        {%- if section.settings.image_mobile != blank -%}
          <source media="(max-width: 749px)" srcset="{{ section.settings.image_mobile | image_url: width: 900 }}">
        {%- endif -%}
        {{
          section.settings.image
          | image_url: width: 1800
          | image_tag:
            class: 'nic-hero__img',
            loading: 'eager',
            fetchpriority: 'high',
            widths: '600, 900, 1200, 1800',
            sizes: '(min-width: 750px) 55vw, 100vw'
        }}
      </picture>
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'nic-hero__img nic-placeholder' }}
    {%- endif -%}
  </div>

  <div class="nic-hero__content">
    {%- if section.settings.eyebrow != blank -%}
      <p class="nic-hero__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h1 class="nic-hero__heading">{{ section.settings.heading }}</h1>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <p class="nic-hero__text">{{ section.settings.text }}</p>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a
        class="nic-btn"
        style="--nic-btn-bg: {{ section.settings.accent_color }}; --nic-btn-fg: {{ section.settings.bg_color }};"
        href="{{ section.settings.button_link | default: routes.all_products_collection_url }}"
      >
        {{- section.settings.button_label -}}
      </a>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .nic-hero {
    display: grid;
    background: var(--hero-bg);
    color: var(--hero-fg);
    font-family: var(--font-body--family);
  }

  .nic-hero__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 5;
  }

  .nic-hero__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .nic-hero__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    padding: 36px 24px 44px;
    text-align: center;
  }

  .nic-hero__eyebrow {
    margin: 0;
    color: var(--hero-accent);
    font-size: clamp(1.125rem, 1rem + 0.8vw, 1.625rem);
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .nic-hero__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(2rem, 1.4rem + 2.6vw, 3.75rem);
    font-weight: 900;
    letter-spacing: 0.01em;
    line-height: 1.05;
    text-transform: uppercase;
  }

  .nic-hero__heading strong,
  .nic-hero__heading b {
    color: var(--hero-accent);
    font-weight: inherit;
  }

  .nic-hero__text {
    max-width: 34ch;
    margin: 0;
    line-height: 1.55;
    opacity: 0.9;
  }

  @media screen and (min-width: 750px) {
    .nic-hero {
      grid-template-columns: 1.15fr 1fr;
      min-height: var(--hero-min-h);
    }

    .nic-hero--right .nic-hero__media {
      order: 2;
    }

    .nic-hero__media {
      aspect-ratio: auto;
    }

    .nic-hero__content {
      justify-content: center;
      padding: 64px clamp(32px, 5vw, 88px);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Nicshape hero",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Images" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image (optional)",
      "info": "Recommended 4:5 ratio."
    },
    {
      "type": "select",
      "id": "image_side",
      "label": "Image position (desktop)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    { "type": "range", "id": "min_height", "label": "Min height (desktop)", "min": 420, "max": 900, "step": 20, "unit": "px", "default": 680 },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "New season" },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "info": "Use bold to highlight words with the accent color.",
      "default": "Buy <strong>2</strong> get <strong>1</strong> free"
    },
    { "type": "text", "id": "text", "label": "Text", "default": "Shapewear and bras that hold you in but feel like nothing." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the sale" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#1e1819" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#fff6ee" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#e3a89f" }
  ],
  "presets": [{ "name": "Nicshape hero" }]
}
{% endschema %}
