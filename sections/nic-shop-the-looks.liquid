{% render 'nic-button-styles' %}

{%- comment -%}nic-hide-empty{%- endcomment -%}
{%- if section.blocks.size > 0 or request.design_mode -%}
<section
  class="nic-looks"
  id="nic-looks-{{ section.id }}"
  style="--looks-bg: {{ section.settings.bg_color }}; --looks-fg: {{ section.settings.text_color }};"
>
  {%- if section.settings.heading != blank -%}
    <h2 class="nic-heading">{{ section.settings.heading }}</h2>
  {%- endif -%}
  {%- if section.settings.subheading != blank -%}
    <p class="nic-subheading">{{ section.settings.subheading }}</p>
  {%- endif -%}

  {%- if section.blocks.size == 0 -%}
    {%- if request.design_mode -%}<p class="nic-looks__empty">Add “Look” blocks with a video and a product.</p>{%- endif -%}
  {%- endif -%}

  <div class="nic-looks__track">
    {%- for block in section.blocks -%}
      {%- assign product = block.settings.product -%}
      <article class="nic-look" {{ block.shopify_attributes }}>
        <div class="nic-look__frame" data-nic-look>
          {%- if block.settings.video != blank -%}
            {{
              block.settings.video
              | video_tag:
                class: 'nic-look__video',
                image_size: '600x',
                loop: true,
                muted: false,
                playsinline: true,
                preload: 'none',
                controls: false
            }}
          {%- elsif block.settings.cover != blank -%}
            {{ block.settings.cover | image_url: width: 700 | image_tag: class: 'nic-look__video', loading: 'lazy', alt: block.settings.label }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'nic-look__video nic-placeholder' }}
          {%- endif -%}

          {%- if block.settings.video != blank -%}
            <button class="nic-look__play" type="button" aria-label="Play video: {{ block.settings.label | escape }}">
              <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor"/></svg>
            </button>
          {%- endif -%}

          {%- if block.settings.badge != blank -%}
            <span class="nic-look__badge">{{ block.settings.badge }}</span>
          {%- endif -%}

          {%- if product != blank -%}
            <a class="nic-look__shop" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 8h12l-1 12H7z"/><path d="M9 8a3 3 0 0 1 6 0"/></svg>
            </a>
          {%- endif -%}

          <span class="nic-look__label">
            {%- if product != blank -%}
              <a href="{{ product.url }}">{{ block.settings.label | default: product.title }}</a>
            {%- else -%}
              {{ block.settings.label }}
            {%- endif -%}
          </span>
        </div>
      </article>
    {%- endfor -%}
  </div>
</section>
{%- endif -%}

<script>
  (function () {
    var root = document.getElementById('nic-looks-{{ section.id }}');
    if (!root) return;
    root.addEventListener('click', function (e) {
      var btn = e.target.closest('.nic-look__play');
      if (!btn) return;
      var frame = btn.closest('[data-nic-look]');
      var video = frame && frame.querySelector('video');
      if (!video) return;
      root.querySelectorAll('video').forEach(function (v) {
        if (v !== video) {
          v.pause();
          v.closest('[data-nic-look]').classList.remove('is-playing');
        }
      });
      if (video.paused) {
        video.play();
        frame.classList.add('is-playing');
      } else {
        video.pause();
        frame.classList.remove('is-playing');
      }
    });
    root.querySelectorAll('video').forEach(function (v) {
      v.addEventListener('ended', function () {
        v.closest('[data-nic-look]').classList.remove('is-playing');
      });
    });
  })();
</script>

{% stylesheet %}
  .nic-looks {
    padding: 40px 0 44px;
    background: var(--looks-bg);
    color: var(--looks-fg);
    font-family: var(--font-body--family);
  }

  .nic-looks .nic-heading,
  .nic-looks .nic-subheading {
    padding-inline: 16px;
  }

  .nic-looks__empty {
    padding: 24px;
    text-align: center;
    opacity: 0.6;
  }

  .nic-looks__track {
    display: flex;
    gap: 12px;
    padding: 4px 16px 8px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .nic-looks__track::-webkit-scrollbar {
    display: none;
  }

  .nic-look {
    flex: 0 0 min(78vw, 300px);
    scroll-snap-align: start;
  }

  .nic-look__frame {
    position: relative;
    aspect-ratio: 9 / 14;
    overflow: hidden;
    border-radius: 16px;
    background: #f3e7e2;
  }

  .nic-look__video {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .nic-look__frame video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .nic-look__play {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: #fff;
    color: #2b2224;
    cursor: pointer;
    transform: translate(-50%, -50%);
    transition: opacity 0.2s ease;
  }

  .nic-look.is-playing .nic-look__play,
  .nic-look__frame.is-playing .nic-look__play {
    opacity: 0;
  }

  .nic-look__frame.is-playing:hover .nic-look__play {
    opacity: 1;
  }

  .nic-look__badge {
    position: absolute;
    bottom: 56px;
    left: 12px;
    display: grid;
    place-items: center;
    width: 72px;
    height: 72px;
    padding: 6px;
    border-radius: 50%;
    background: #fff;
    color: #2b2224;
    font-size: 0.6875rem;
    font-weight: 800;
    line-height: 1.15;
    text-align: center;
    text-transform: uppercase;
  }

  .nic-look__shop {
    position: absolute;
    top: 12px;
    right: 12px;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 8px;
    background: #fff;
    color: #2b2224;
  }

  .nic-look__label {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    padding: 28px 14px 12px;
    background: linear-gradient(to top, rgb(0 0 0 / 55%), transparent);
    color: #fff;
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .nic-look__label a {
    color: inherit;
    text-decoration: none;
  }

  @media screen and (min-width: 750px) {
    .nic-looks__track {
      justify-content: flex-start;
      padding-inline: max(32px, calc((100% - 1400px) / 2));
    }

    .nic-look {
      flex-basis: 260px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Nicshape shop the looks",
  "tag": "section",
  "max_blocks": 10,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop the looks" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Tap the video, shop the look." },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#2b2224" }
  ],
  "blocks": [
    {
      "type": "look",
      "name": "Look",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Video",
          "info": "Upload from Content → Files. Only use videos you own or have permission to use."
        },
        { "type": "image_picker", "id": "cover", "label": "Image (used when there is no video)" },
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "label", "label": "Label", "info": "Defaults to the product title." },
        { "type": "text", "id": "badge", "label": "Round badge (optional)", "info": "e.g. “1 pair free”" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Nicshape shop the looks",
      "blocks": [{ "type": "look" }, { "type": "look" }, { "type": "look" }]
    }
  ]
}
{% endschema %}
