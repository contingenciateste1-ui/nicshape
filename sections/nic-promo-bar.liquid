{%- liquid
  assign countdown_end = section.settings.countdown_end | strip
  assign link = section.settings.link
-%}

<div
  class="nic-promo"
  id="nic-promo-{{ section.id }}"
  style="
    --promo-bg: {{ section.settings.bg_color }};
    --promo-fg: {{ section.settings.text_color }};
    --promo-accent: {{ section.settings.accent_color }};
  "
>
  <div class="nic-promo__main">
    {%- if section.settings.headline != blank or section.settings.subline != blank -%}
      {%- if link != blank -%}
        <a class="nic-promo__copy" href="{{ link }}">
      {%- else -%}
        <div class="nic-promo__copy">
      {%- endif -%}
      {%- if section.settings.headline != blank -%}
        <span class="nic-promo__headline">{{ section.settings.headline }}</span>
      {%- endif -%}
      {%- if section.settings.subline != blank -%}
        <span class="nic-promo__tag">{{ section.settings.subline }}</span>
      {%- endif -%}
      {%- if link != blank -%}
        </a>
      {%- else -%}
        </div>
      {%- endif -%}
    {%- endif -%}

    {%- if countdown_end != blank -%}
      <div class="nic-promo__countdown" data-nic-countdown data-end="{{ countdown_end }}" role="timer">
        <div class="nic-promo__unit">
          <span class="nic-promo__digits" data-unit="d">00</span>
          <span class="nic-promo__label">{{ section.settings.label_days }}</span>
        </div>
        <span class="nic-promo__sep" aria-hidden="true">:</span>
        <div class="nic-promo__unit">
          <span class="nic-promo__digits" data-unit="h">00</span>
          <span class="nic-promo__label">{{ section.settings.label_hours }}</span>
        </div>
        <span class="nic-promo__sep" aria-hidden="true">:</span>
        <div class="nic-promo__unit">
          <span class="nic-promo__digits" data-unit="m">00</span>
          <span class="nic-promo__label">{{ section.settings.label_minutes }}</span>
        </div>
        <span class="nic-promo__sep" aria-hidden="true">:</span>
        <div class="nic-promo__unit">
          <span class="nic-promo__digits" data-unit="s">00</span>
          <span class="nic-promo__label">{{ section.settings.label_seconds }}</span>
        </div>
      </div>
    {%- endif -%}
  </div>

  {%- if section.blocks.size > 0 -%}
    <div class="nic-promo__rotator" aria-live="off">
      {%- for block in section.blocks -%}
        <p
          class="nic-promo__msg{% if forloop.first %} is-active{% endif %}"
          {{ block.shopify_attributes }}
        >
          {{- block.settings.text -}}
        </p>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

<script>
  (function () {
    var root = document.getElementById('nic-promo-{{ section.id }}');
    if (!root) return;

    var timers = [];

    var cd = root.querySelector('[data-nic-countdown]');
    if (cd) {
      var raw = (cd.getAttribute('data-end') || '').replace(' ', 'T');
      var end = new Date(raw).getTime();
      var pad = function (n) {
        return n < 10 ? '0' + n : String(n);
      };
      var els = {
        d: cd.querySelector('[data-unit="d"]'),
        h: cd.querySelector('[data-unit="h"]'),
        m: cd.querySelector('[data-unit="m"]'),
        s: cd.querySelector('[data-unit="s"]'),
      };
      var tick = function () {
        var diff = end - Date.now();
        if (isNaN(end) || diff <= 0) {
          cd.hidden = true;
          return false;
        }
        cd.hidden = false;
        var s = Math.floor(diff / 1000);
        els.d.textContent = pad(Math.floor(s / 86400));
        els.h.textContent = pad(Math.floor((s % 86400) / 3600));
        els.m.textContent = pad(Math.floor((s % 3600) / 60));
        els.s.textContent = pad(s % 60);
        return true;
      };
      if (tick()) {
        var id = setInterval(function () {
          if (!document.body.contains(root) || !tick()) clearInterval(id);
        }, 1000);
        timers.push(id);
      }
    }

    var msgs = root.querySelectorAll('.nic-promo__msg');
    if (msgs.length > 1 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      var i = 0;
      var rid = setInterval(function () {
        if (!document.body.contains(root)) return clearInterval(rid);
        msgs[i].classList.remove('is-active');
        i = (i + 1) % msgs.length;
        msgs[i].classList.add('is-active');
      }, 4000);
    }
  })();
</script>

{% stylesheet %}
  .nic-promo {
    background: var(--promo-bg);
    color: var(--promo-fg);
    font-family: var(--font-body--family);
    text-align: center;
  }

  .nic-promo__main {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 8px 24px;
    padding: 10px 16px;
  }

  .nic-promo__copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    color: inherit;
    text-decoration: none;
  }

  .nic-promo__headline {
    color: var(--promo-accent);
    font-size: clamp(1.25rem, 1rem + 1.2vw, 1.75rem);
    font-weight: 800;
    letter-spacing: 0.03em;
    line-height: 1;
    text-transform: uppercase;
  }

  .nic-promo__tag {
    padding: 3px 10px;
    border-radius: 3px;
    background: var(--promo-accent);
    color: var(--promo-bg);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .nic-promo__countdown {
    display: flex;
    align-items: flex-start;
    gap: 6px;
  }

  .nic-promo__countdown[hidden] {
    display: none;
  }

  .nic-promo__unit {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
  }

  .nic-promo__digits {
    display: grid;
    place-items: center;
    min-width: 34px;
    height: 28px;
    border-radius: 4px;
    background: rgb(255 255 255 / 14%);
    font-size: 1.125rem;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
  }

  .nic-promo__label {
    font-size: 0.5625rem;
    letter-spacing: 0.08em;
    opacity: 0.7;
    text-transform: uppercase;
  }

  .nic-promo__sep {
    line-height: 28px;
    font-weight: 700;
  }

  .nic-promo__rotator {
    display: grid;
    padding: 0 16px 10px;
  }

  .nic-promo__msg {
    grid-area: 1 / 1;
    margin: 0;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    opacity: 0;
    text-transform: uppercase;
    transition: opacity 0.4s ease;
  }

  .nic-promo__msg.is-active {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .nic-promo__msg {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Nicshape promo bar",
  "tag": "div",
  "class": "nic-promo-section",
  "max_blocks": 4,
  "settings": [
    { "type": "header", "content": "Campaign" },
    { "type": "text", "id": "headline", "label": "Headline", "default": "Autumn Sale" },
    { "type": "text", "id": "subline", "label": "Tag next to headline", "default": "Buy 2 · Get 1 free" },
    { "type": "url", "id": "link", "label": "Link (optional)" },
    { "type": "header", "content": "Countdown" },
    {
      "type": "text",
      "id": "countdown_end",
      "label": "End date and time",
      "info": "Format: YYYY-MM-DD HH:MM (viewer's local time), e.g. 2026-11-30 23:59. Leave empty to hide the timer. It hides itself once it ends."
    },
    { "type": "text", "id": "label_days", "label": "Days label", "default": "Days" },
    { "type": "text", "id": "label_hours", "label": "Hours label", "default": "Hrs" },
    { "type": "text", "id": "label_minutes", "label": "Minutes label", "default": "Min" },
    { "type": "text", "id": "label_seconds", "label": "Seconds label", "default": "Sec" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#1e1819" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#ffffff" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#e3a89f" }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Rotating message",
      "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "Free shipping over €39" }]
    }
  ],
  "presets": [
    {
      "name": "Nicshape promo bar",
      "blocks": [{ "type": "message" }, { "type": "message" }]
    }
  ]
}
{% endschema %}
