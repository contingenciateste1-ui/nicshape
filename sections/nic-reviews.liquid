{%- liquid
  assign tab_list = ''
  for block in section.blocks
    if block.type == 'product_tab'
      assign t = block.settings.label | strip
      if t != blank
        assign key = t | append: '||'
        unless tab_list contains key
          assign tab_list = tab_list | append: key
        endunless
      endif
    endif
  endfor
  assign has_pcards = false
  if tab_list != blank
    assign has_pcards = true
  endif
  unless has_pcards
    for block in section.blocks
      if block.type == 'review'
        assign t = block.settings.tab | strip
        if t != blank
          assign key = t | append: '||'
          unless tab_list contains key
            assign tab_list = tab_list | append: key
          endunless
        endif
      endif
    endfor
  endunless
  assign tabs = tab_list | split: '||'
  assign first_tab = tabs | first | handleize
  assign use_tabs = false
  if tabs.size > 0 and section.settings.show_tabs
    assign use_tabs = true
  endif
  assign has_summary = false
  if section.settings.show_summary
    if section.settings.rating_label != blank or section.settings.count_label != blank or section.settings.show_stars
      assign has_summary = true
    endif
  endif
-%}

{%- comment -%}nic-hide-empty{%- endcomment -%}
{%- if section.blocks.size > 0 or request.design_mode -%}
  <section
    class="nic-reviews nic-reviews--{{ section.settings.card_align }}{% if section.settings.card_shadow %} nic-reviews--shadow{% endif %}"
    id="nic-reviews-{{ section.id }}"
    style="
      --rev-bg: {{ section.settings.bg_color }};
      --rev-pt-d: {{ section.settings.padding_top_desktop }}px;
      --rev-pb-d: {{ section.settings.padding_bottom_desktop }}px;
      --rev-pt-m: {{ section.settings.padding_top_mobile }}px;
      --rev-pb-m: {{ section.settings.padding_bottom_mobile }}px;
      --rev-sum-size: {{ section.settings.summary_size }}px;
      --rev-sum-color: {{ section.settings.summary_color }};
      --rev-h-size: {{ section.settings.heading_size }}px;
      --rev-h-weight: {{ section.settings.heading_weight }};
      --rev-h-color: {{ section.settings.heading_color }};
      --rev-h-align: {{ section.settings.heading_align }};
      --rev-tab-size: {{ section.settings.tab_font_size }}px;
      --rev-tab-radius: {{ section.settings.tab_radius }}px;
      --rev-tab-border: {{ section.settings.tab_border_color }};
      --rev-tab-text: {{ section.settings.tab_text_color }};
      --rev-tab-active-bg: {{ section.settings.tab_active_bg }};
      --rev-tab-active-text: {{ section.settings.tab_active_text }};
      --rev-tab-justify: {{ section.settings.tab_align }};
      --rev-pc-w: {{ section.settings.pcard_width }}px;
      --rev-pc-radius: {{ section.settings.pcard_radius }}px;
      --rev-pc-ratio: {{ section.settings.pcard_ratio }};
      --rev-pc-size: {{ section.settings.pcard_label_size }}px;
      --rev-pc-active: {{ section.settings.pcard_active_color }};
      --rev-pc-bg: {{ section.settings.pcard_bg }};
      --rev-cols: {{ section.settings.cards_desktop }};
      --rev-card-w-m: {{ section.settings.card_width_mobile }}vw;
      --rev-card-bg: {{ section.settings.card_bg }};
      --rev-card-radius: {{ section.settings.card_radius }}px;
      --rev-card-pad: {{ section.settings.card_padding }}px;
      --rev-card-gap: {{ section.settings.card_gap }}px;
      --rev-card-min-h: {{ section.settings.card_min_height }}px;
      --rev-card-bw: {{ section.settings.card_border_width }}px;
      --rev-card-bc: {{ section.settings.card_border_color }};
      --rev-name-size: {{ section.settings.name_size }}px;
      --rev-name-weight: {{ section.settings.name_weight }};
      --rev-name-color: {{ section.settings.name_color }};
      --rev-badge-bg: {{ section.settings.badge_bg }};
      --rev-badge-text: {{ section.settings.badge_text }};
      --rev-badge-size: {{ section.settings.badge_size }}px;
      --rev-star: {{ section.settings.star_color }};
      --rev-star-off: {{ section.settings.star_empty_color }};
      --rev-star-size: {{ section.settings.star_size }}px;
      --rev-text-size: {{ section.settings.text_size }}px;
      --rev-text-color: {{ section.settings.text_color }};
      --rev-text-lh: {{ section.settings.text_line_height }};
      --rev-meta-color: {{ section.settings.meta_color }};
    "
  >
    {%- if has_summary -%}
      <p class="nic-reviews__summary">
        {%- if section.settings.rating_label != blank -%}
          <span>{{ section.settings.rating_label }}</span>
        {%- endif -%}
        {%- if section.settings.show_stars -%}
          <span class="nic-reviews__summary-stars" aria-hidden="true">★★★★★</span>
        {%- endif -%}
        {%- if section.settings.count_label != blank -%}
          <span>{{ section.settings.count_label }}</span>
        {%- endif -%}
      </p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="nic-reviews__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if request.design_mode and section.blocks.size == 0 -%}
      <p class="nic-reviews__empty">Add “Review” blocks with real customer reviews. Use the same “Tab” text on reviews to group them under one tab (for example, a product name).</p>
    {%- endif -%}

    {%- if use_tabs and has_pcards -%}
      <div class="nic-reviews__pcards" role="tablist">
        {%- for block in section.blocks -%}
          {%- if block.type != 'product_tab' or block.settings.label == blank -%}{%- continue -%}{%- endif -%}
          {%- assign tab_handle = block.settings.label | strip | handleize -%}
          <button
            class="nic-reviews__pcard{% if tab_handle == first_tab %} is-active{% endif %}"
            type="button"
            role="tab"
            aria-selected="{% if tab_handle == first_tab %}true{% else %}false{% endif %}"
            data-tab="{{ tab_handle }}"
            {{ block.shopify_attributes }}
          >
            <span class="nic-reviews__pcard-media">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 400
                  | image_tag: loading: 'lazy', widths: '200, 300, 400', sizes: '160px', alt: block.settings.label
                }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'nic-reviews__pcard-ph' }}
              {%- endif -%}
            </span>
            <span class="nic-reviews__pcard-label">{{ block.settings.label }}</span>
          </button>
        {%- endfor -%}
      </div>
    {%- elsif use_tabs -%}
      <div class="nic-reviews__tabs" role="tablist">
        {%- for tab in tabs -%}
          {%- assign tab_handle = tab | handleize -%}
          <button
            class="nic-reviews__tab{% if tab_handle == first_tab %} is-active{% endif %}"
            type="button"
            role="tab"
            aria-selected="{% if tab_handle == first_tab %}true{% else %}false{% endif %}"
            data-tab="{{ tab_handle }}"
          >
            {{- tab -}}
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="nic-reviews__track" data-nic-track>
      {%- for block in section.blocks -%}
        {%- if block.type != 'review' -%}{%- continue -%}{%- endif -%}
        {%- assign stars = block.settings.rating | plus: 0 -%}
        {%- assign card_tab = block.settings.tab | strip | handleize -%}
        {%- assign badge_label = block.settings.verified_label | default: section.settings.verified_label -%}
        <article
          class="nic-review{% if use_tabs and card_tab != first_tab %} is-hidden{% endif %}"
          data-tab="{{ card_tab }}"
          {% if block.settings.card_bg != blank or block.settings.card_text != blank %}
            style="
              {% if block.settings.card_bg != blank %}--rev-card-bg: {{ block.settings.card_bg }};{% endif %}
              {% if block.settings.card_text != blank %}--rev-text-color: {{ block.settings.card_text }}; --rev-name-color: {{ block.settings.card_text }};{% endif %}
            "
          {% endif %}
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.image != blank -%}
            <div class="nic-review__photo">
              {{
                block.settings.image
                | image_url: width: 700
                | image_tag: loading: 'lazy', widths: '300, 450, 700', sizes: '(min-width: 750px) 30vw, 84vw', alt: block.settings.name
              }}
            </div>
          {%- endif -%}

          <div class="nic-review__head">
            {%- if block.settings.name != blank -%}
              <span class="nic-review__name">{{ block.settings.name }}</span>
            {%- endif -%}
            {%- if block.settings.show_verified and badge_label != blank -%}
              <span class="nic-review__verified">
                {%- if section.settings.badge_icon -%}
                  <svg viewBox="0 0 20 20" width="1.1em" height="1.1em" aria-hidden="true"><circle cx="10" cy="10" r="10" fill="currentColor"/><path d="M5.5 10.4l3 3 6-6.4" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                {%- endif -%}
                {{ badge_label }}
              </span>
            {%- endif -%}
          </div>

          {%- if section.settings.show_stars_on_cards -%}
            <div class="nic-review__stars" role="img" aria-label="{{ stars }} / 5">
              {%- for i in (1..5) -%}<span class="{% if i > stars %}is-off{% endif %}">★</span>{%- endfor -%}
            </div>
          {%- endif -%}

          {%- if block.settings.title != blank -%}
            <p class="nic-review__title">{{ block.settings.title }}</p>
          {%- endif -%}

          {%- if block.settings.text != blank -%}
            <p class="nic-review__text">{{ block.settings.text }}</p>
          {%- endif -%}

          {%- if block.settings.date != blank or block.settings.product_name != blank -%}
            <p class="nic-review__meta">
              {%- if block.settings.date != blank -%}<span>{{ block.settings.date }}</span>{%- endif -%}
              {%- if block.settings.product_name != blank -%}
                {%- if block.settings.product_link != blank -%}
                  <a href="{{ block.settings.product_link }}">{{ block.settings.product_name }}</a>
                {%- else -%}
                  <span>{{ block.settings.product_name }}</span>
                {%- endif -%}
              {%- endif -%}
            </p>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>

    {%- if section.settings.show_arrows -%}
      <div class="nic-reviews__arrows" data-nic-arrows hidden>
        <button class="nic-reviews__arrow" type="button" data-nic-prev aria-label="Previous">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg>
        </button>
        <button class="nic-reviews__arrow" type="button" data-nic-next aria-label="Next">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>
        </button>
      </div>
    {%- endif -%}
  </section>

  <script>
    (function () {
      var root = document.getElementById('nic-reviews-{{ section.id }}');
      if (!root) return;
      var track = root.querySelector('[data-nic-track]');
      var tabs = root.querySelectorAll('.nic-reviews__tab, .nic-reviews__pcard');
      var cards = root.querySelectorAll('.nic-review');
      var arrows = root.querySelector('[data-nic-arrows]');

      function updateArrows() {
        if (!arrows || !track) return;
        arrows.hidden = !(track.scrollWidth > track.clientWidth + 4);
      }

      tabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
          var key = tab.getAttribute('data-tab');
          tabs.forEach(function (t) {
            var on = t === tab;
            t.classList.toggle('is-active', on);
            t.setAttribute('aria-selected', on ? 'true' : 'false');
          });
          cards.forEach(function (c) {
            c.classList.toggle('is-hidden', c.getAttribute('data-tab') !== key);
          });
          if (track) track.scrollLeft = 0;
          updateArrows();
        });
      });

      if (arrows && track) {
        var prev = arrows.querySelector('[data-nic-prev]');
        var next = arrows.querySelector('[data-nic-next]');
        prev.addEventListener('click', function () {
          track.scrollBy({ left: -track.clientWidth * 0.9, behavior: 'smooth' });
        });
        next.addEventListener('click', function () {
          track.scrollBy({ left: track.clientWidth * 0.9, behavior: 'smooth' });
        });
        window.addEventListener('resize', updateArrows);
        updateArrows();
      }
    })();
  </script>
{%- endif -%}

{% stylesheet %}
  .nic-reviews {
    padding-top: var(--rev-pt-m);
    padding-bottom: var(--rev-pb-m);
    background: var(--rev-bg);
    color: var(--rev-text-color);
    font-family: var(--font-body--family);
  }

  .nic-reviews__summary {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 6px 10px;
    margin: 0 0 14px;
    padding-inline: 16px;
    color: var(--rev-sum-color);
    font-size: var(--rev-sum-size);
    text-align: center;
  }

  .nic-reviews__summary-stars {
    color: var(--rev-star);
    letter-spacing: 2px;
  }

  .nic-reviews__heading {
    margin: 0 0 32px;
    padding-inline: 16px;
    color: var(--rev-h-color);
    font-family: var(--font-heading--family);
    font-size: min(var(--rev-h-size), 7.5vw);
    font-weight: var(--rev-h-weight);
    line-height: 1.15;
    text-align: var(--rev-h-align);
  }

  .nic-reviews__empty {
    padding: 24px;
    text-align: center;
    opacity: 0.6;
  }

  .nic-reviews__tabs {
    display: flex;
    flex-wrap: nowrap;
    gap: 10px;
    justify-content: flex-start;
    margin: 0 0 28px;
    padding: 0 16px 4px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .nic-reviews__tabs::-webkit-scrollbar {
    display: none;
  }

  .nic-reviews__tab {
    flex: 0 0 auto;
    padding: 0.85em 1.7em;
    border: 1px solid var(--rev-tab-border);
    border-radius: var(--rev-tab-radius);
    background: transparent;
    color: var(--rev-tab-text);
    font-family: inherit;
    font-size: var(--rev-tab-size);
    font-weight: 700;
    line-height: 1.1;
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .nic-reviews__tab.is-active {
    border-color: var(--rev-tab-active-bg);
    background: var(--rev-tab-active-bg);
    color: var(--rev-tab-active-text);
  }

  .nic-reviews__tab:focus-visible,
  .nic-reviews__arrow:focus-visible {
    outline: 2px solid currentcolor;
    outline-offset: 3px;
  }

  .nic-reviews__pcards {
    display: flex;
    gap: 14px;
    justify-content: flex-start;
    margin: 0 0 28px;
    padding: 0 16px 4px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .nic-reviews__pcards::-webkit-scrollbar {
    display: none;
  }

  .nic-reviews__pcard {
    display: flex;
    flex: 0 0 calc(var(--rev-pc-w) * 0.8);
    flex-direction: column;
    gap: 10px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--rev-tab-text);
    font-family: inherit;
    cursor: pointer;
    text-align: center;
  }

  .nic-reviews__pcard-media {
    display: block;
    width: 100%;
    aspect-ratio: var(--rev-pc-ratio);
    overflow: hidden;
    border: 2px solid transparent;
    border-radius: var(--rev-pc-radius);
    background: var(--rev-pc-bg);
    opacity: 0.7;
    transition:
      border-color 0.2s ease,
      opacity 0.2s ease;
  }

  .nic-reviews__pcard-media img,
  .nic-reviews__pcard-media svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .nic-reviews__pcard-label {
    font-size: var(--rev-pc-size);
    font-weight: 600;
    line-height: 1.25;
  }

  .nic-reviews__pcard.is-active .nic-reviews__pcard-media {
    border-color: var(--rev-pc-active);
    opacity: 1;
  }

  .nic-reviews__pcard.is-active .nic-reviews__pcard-label {
    font-weight: 800;
  }

  .nic-reviews__pcard:focus-visible {
    outline: 2px solid currentcolor;
    outline-offset: 3px;
  }

  .nic-reviews__track {
    display: flex;
    gap: var(--rev-card-gap);
    padding: 4px 16px 8px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .nic-reviews__track::-webkit-scrollbar {
    display: none;
  }

  .nic-review {
    display: flex;
    flex: 0 0 var(--rev-card-w-m);
    flex-direction: column;
    align-items: center;
    gap: 12px;
    min-height: var(--rev-card-min-h);
    padding: var(--rev-card-pad);
    overflow: hidden;
    border: var(--rev-card-bw) solid var(--rev-card-bc);
    border-radius: var(--rev-card-radius);
    background: var(--rev-card-bg);
    color: var(--rev-text-color);
    text-align: center;
    scroll-snap-align: start;
  }

  .nic-reviews--left .nic-review {
    align-items: flex-start;
    text-align: left;
  }

  .nic-reviews--shadow .nic-review {
    box-shadow: 0 6px 24px rgb(0 0 0 / 8%);
  }

  .nic-review.is-hidden {
    display: none;
  }

  .nic-review__photo {
    width: calc(100% + var(--rev-card-pad) * 2);
    margin: calc(var(--rev-card-pad) * -1) calc(var(--rev-card-pad) * -1) 4px;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .nic-review__photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .nic-review__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 8px 10px;
  }

  .nic-reviews--left .nic-review__head {
    justify-content: flex-start;
  }

  .nic-review__name {
    color: var(--rev-name-color);
    font-size: var(--rev-name-size);
    font-weight: var(--rev-name-weight);
  }

  .nic-review__verified {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    padding: 0.3em 0.9em 0.3em 0.6em;
    border-radius: 999px;
    background: var(--rev-badge-bg);
    color: var(--rev-badge-text);
    font-size: var(--rev-badge-size);
    font-weight: 700;
    line-height: 1.2;
  }

  .nic-review__verified:not(:has(svg)) {
    padding-left: 0.9em;
  }

  .nic-review__stars {
    color: var(--rev-star);
    font-size: var(--rev-star-size);
    letter-spacing: 0.15em;
    line-height: 1;
  }

  .nic-review__stars .is-off {
    color: var(--rev-star-off);
  }

  .nic-review__title {
    margin: 0;
    color: var(--rev-name-color);
    font-size: var(--rev-text-size);
    font-weight: 700;
    line-height: 1.35;
  }

  .nic-review__text {
    margin: 0;
    color: var(--rev-text-color);
    font-size: var(--rev-text-size);
    line-height: var(--rev-text-lh);
  }

  .nic-review__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    justify-content: center;
    margin: auto 0 0;
    color: var(--rev-meta-color);
    font-size: 0.8125rem;
  }

  .nic-reviews--left .nic-review__meta {
    justify-content: flex-start;
  }

  .nic-review__meta a {
    color: inherit;
    text-decoration: underline;
  }

  .nic-reviews__arrows {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-top: 20px;
  }

  .nic-reviews__arrows[hidden] {
    display: none;
  }

  .nic-reviews__arrow {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    padding: 0;
    border: 1px solid var(--rev-tab-border);
    border-radius: 50%;
    background: transparent;
    color: var(--rev-tab-text);
    cursor: pointer;
  }

  @media screen and (min-width: 750px) {
    .nic-reviews {
      padding-top: var(--rev-pt-d);
      padding-bottom: var(--rev-pb-d);
    }

    .nic-reviews__heading {
      font-size: var(--rev-h-size);
    }

    .nic-reviews__tabs {
      flex-wrap: wrap;
      justify-content: var(--rev-tab-justify);
      margin-bottom: 40px;
      padding-inline: 32px;
      overflow: visible;
    }

    .nic-reviews__pcards {
      justify-content: var(--rev-tab-justify);
      margin-bottom: 40px;
      padding-inline: 32px;
      overflow: visible;
      flex-wrap: wrap;
      gap: 20px;
    }

    .nic-reviews__pcard {
      flex-basis: var(--rev-pc-w);
    }

    .nic-reviews__track {
      max-width: 1600px;
      margin-inline: auto;
      padding-inline: 32px;
    }

    .nic-review {
      flex: 0 0 calc((100% - var(--rev-card-gap) * (var(--rev-cols) - 1)) / var(--rev-cols));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Nicshape reviews",
  "tag": "div",
  "max_blocks": 60,
  "settings": [
    { "type": "header", "content": "Summary line" },
    { "type": "checkbox", "id": "show_summary", "label": "Show summary line", "default": true },
    {
      "type": "text",
      "id": "rating_label",
      "label": "Rating text",
      "info": "Example: 4.9/5. Only write numbers that match your real review data."
    },
    { "type": "checkbox", "id": "show_stars", "label": "Show stars in the summary", "default": true },
    {
      "type": "text",
      "id": "count_label",
      "label": "Count text",
      "info": "Example: 1,200 verified reviews."
    },
    { "type": "range", "id": "summary_size", "label": "Text size", "min": 11, "max": 22, "step": 1, "unit": "px", "default": 14 },
    { "type": "color", "id": "summary_color", "label": "Text color", "default": "#666666" },

    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved by our customers" },
    { "type": "range", "id": "heading_size", "label": "Size (desktop)", "min": 22, "max": 72, "step": 2, "unit": "px", "default": 40 },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Weight",
      "options": [
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra bold" }
      ],
      "default": "700"
    },
    {
      "type": "select",
