{% render 'nic-button-styles' %}

{%- liquid
  assign tab_list = ''
  for block in section.blocks
    assign t = block.settings.tab | strip
    if t != blank
      assign key = t | append: '||'
      unless tab_list contains key
        assign tab_list = tab_list | append: key
      endunless
    endif
  endfor
  assign tabs = tab_list | split: '||'
  assign first_tab = tabs | first | handleize
  assign has_summary = false
  if section.settings.rating_label != blank or section.settings.count_label != blank
    assign has_summary = true
  endif
-%}

{%- comment -%}nic-hide-empty{%- endcomment -%}
{%- if section.blocks.size > 0 or request.design_mode -%}
  <section
    class="nic-reviews"
    id="nic-reviews-{{ section.id }}"
    style="
      --rev-bg: {{ section.settings.bg_color }};
      --rev-fg: {{ section.settings.text_color }};
      --rev-star: {{ section.settings.star_color }};
      --rev-card: {{ section.settings.card_color }};
      --rev-tab-active: {{ section.settings.tab_active_color }};
    "
  >
    {%- if has_summary -%}
      <p class="nic-reviews__summary">
        {%- if section.settings.rating_label != blank -%}
          <span>{{ section.settings.rating_label }}</span>
        {%- endif -%}
        {%- if section.settings.show_stars -%}
          <span class="nic-reviews__stars" aria-hidden="true">★★★★★</span>
        {%- endif -%}
        {%- if section.settings.count_label != blank -%}
          <span>{{ section.settings.count_label }}</span>
        {%- endif -%}
      </p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="nic-reviews__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if request.design_mode and section.blocks.size == 0 -%}
      <p class="nic-reviews__empty">Add “Review” blocks with real customer reviews. Use the same “Tab” text to group reviews by product.</p>
    {%- endif -%}

    {%- if tabs.size > 0 -%}
      <div class="nic-reviews__tabs" role="tablist">
        {%- for tab in tabs -%}
          {%- assign tab_handle = tab | handleize -%}
          <button
            class="nic-reviews__tab{% if tab_handle == first_tab %} is-active{% endif %}"
            type="button"
            role="tab"
            aria-selected="{% if tab_handle == first_tab %}true{% else %}false{% endif %}"
            data-tab="{{ tab_handle }}"
          >
            {{- tab -}}
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="nic-reviews__track">
      {%- for block in section.blocks -%}
        {%- assign stars = block.settings.rating | plus: 0 -%}
        {%- assign card_tab = block.settings.tab | strip | handleize -%}
        <article
          class="nic-review{% if tabs.size > 0 and card_tab != first_tab %} is-hidden{% endif %}"
          data-tab="{{ card_tab }}"
          {{ block.shopify_attributes }}
        >
          <div class="nic-review__head">
            <span class="nic-review__name">{{ block.settings.name }}</span>
            {%- if block.settings.verified -%}
              <span class="nic-review__verified">
                <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><circle cx="10" cy="10" r="10" fill="currentColor"/><path d="M5.5 10.4l3 3 6-6.4" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                Verified Buyer
              </span>
            {%- endif -%}
          </div>
          <div class="nic-review__stars" role="img" aria-label="{{ stars }} / 5">
            {%- for i in (1..5) -%}<span class="{% if i > stars %}is-off{% endif %}">★</span>{%- endfor -%}
          </div>
          <p class="nic-review__text">{{ block.settings.text }}</p>
        </article>
      {%- endfor -%}
    </div>
  </section>

  <script>
    (function () {
      var root = document.getElementById('nic-reviews-{{ section.id }}');
      if (!root) return;
      var tabs = root.querySelectorAll('.nic-reviews__tab');
      if (!tabs.length) return;
      var cards = root.querySelectorAll('.nic-review');
      var track = root.querySelector('.nic-reviews__track');
      tabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
          var key = tab.getAttribute('data-tab');
          tabs.forEach(function (t) {
            var on = t === tab;
            t.classList.toggle('is-active', on);
            t.setAttribute('aria-selected', on ? 'true' : 'false');
          });
          cards.forEach(function (c) {
            c.classList.toggle('is-hidden', c.getAttribute('data-tab') !== key);
          });
          if (track) track.scrollLeft = 0;
        });
      });
    })();
  </script>
{%- endif -%}

{% stylesheet %}
  .nic-reviews {
    padding: 48px 0 56px;
    background: var(--rev-bg);
    color: var(--rev-fg);
    font-family: var(--font-body--family);
  }

  .nic-reviews__summary {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 6px 10px;
    margin: 0 0 12px;
    padding-inline: 16px;
    color: #666;
    font-size: 0.9375rem;
    text-align: center;
  }

  .nic-reviews__stars {
    color: var(--rev-star);
    letter-spacing: 2px;
  }

  .nic-reviews__heading {
    margin: 0 0 28px;
    padding-inline: 16px;
    font-family: var(--font-heading--family);
    font-size: clamp(1.625rem, 1.2rem + 1.8vw, 2.75rem);
    font-weight: 700;
    line-height: 1.15;
    text-align: center;
  }

  .nic-reviews__empty {
    padding: 24px;
    text-align: center;
    opacity: 0.6;
  }

  .nic-reviews__tabs {
    display: flex;
    flex-wrap: nowrap;
    gap: 10px;
    margin: 0 auto 32px;
    padding: 0 16px 4px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .nic-reviews__tabs::-webkit-scrollbar {
    display: none;
  }

  .nic-reviews__tab {
    flex: 0 0 auto;
    padding: 12px 24px;
    border: 1px solid #e3e0de;
    border-radius: 999px;
    background: transparent;
    color: inherit;
    font-family: inherit;
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.1;
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .nic-reviews__tab.is-active {
    border-color: var(--rev-tab-active);
    background: var(--rev-tab-active);
    color: #fff;
  }

  .nic-reviews__tab:focus-visible {
    outline: 2px solid currentcolor;
    outline-offset: 3px;
  }

  .nic-reviews__track {
    display: flex;
    gap: 14px;
    padding: 4px 16px 8px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .nic-reviews__track::-webkit-scrollbar {
    display: none;
  }

  .nic-review {
    display: flex;
    flex: 0 0 min(84vw, 340px);
    flex-direction: column;
    align-items: center;
    gap: 12px;
    min-height: 260px;
    padding: 28px 22px;
    border-radius: 22px;
    background: var(--rev-card);
    text-align: center;
    scroll-snap-align: start;
  }

  .nic-review.is-hidden {
    display: none;
  }

  .nic-review__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 8px 10px;
  }

  .nic-review__name {
    font-size: 1.0625rem;
    font-weight: 700;
  }

  .nic-review__verified {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 4px 12px 4px 8px;
    border-radius: 999px;
    background: #e6f1e2;
    color: #2e7a3d;
    font-size: 0.8125rem;
    font-weight: 700;
  }

  .nic-review__stars {
    color: var(--rev-star);
    font-size: 1.125rem;
    letter-spacing: 3px;
  }

  .nic-review__stars .is-off {
    color: #ddd0ca;
  }

  .nic-review__text {
    margin: 0;
    font-size: 1rem;
    line-height: 1.6;
  }

  @media screen and (min-width: 750px) {
    .nic-reviews {
      padding: 64px 0 72px;
    }

    .nic-reviews__tabs {
      flex-wrap: wrap;
      justify-content: center;
      overflow: visible;
    }

    .nic-reviews__tab {
      padding: 14px 32px;
      font-size: 1rem;
    }

    .nic-reviews__track {
      gap: 24px;
      max-width: 1500px;
      margin-inline: auto;
      padding-inline: 32px;
    }

    .nic-review {
      flex: 0 0 calc((100% - 48px) / 3);
      padding: 36px 28px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Nicshape reviews",
  "tag": "div",
  "max_blocks": 30,
  "settings": [
    { "type": "header", "content": "Summary line" },
    {
      "type": "text",
      "id": "rating_label",
      "label": "Rating text",
      "info": "Example: 4.9/5. Only write numbers that match your real review data. Leave empty to hide."
    },
    { "type": "checkbox", "id": "show_stars", "label": "Show stars in the summary", "default": true },
    {
      "type": "text",
      "id": "count_label",
      "label": "Count text",
      "info": "Example: 1,200 verified reviews. Leave empty to hide."
    },
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved by our customers" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#2b2224" },
    { "type": "color", "id": "star_color", "label": "Stars", "default": "#c9a26d" },
    { "type": "color", "id": "card_color", "label": "Review card", "default": "#f6f6f6" },
    { "type": "color", "id": "tab_active_color", "label": "Active tab", "default": "#111111" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "text",
          "id": "tab",
          "label": "Tab",
          "info": "Reviews with the same tab text are grouped under one tab pill (for example, a product name). Leave empty on all reviews to hide the tabs."
        },
        { "type": "text", "id": "name", "label": "Customer name" },
        { "type": "textarea", "id": "text", "label": "Review", "info": "Use real reviews from your customers only." },
        {
          "type": "select",
          "id": "rating",
          "label": "Rating",
          "options": [
            { "value": "5", "label": "5 stars" },
            { "value": "4", "label": "4 stars" },
            { "value": "3", "label": "3 stars" }
          ],
          "default": "5"
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Show “Verified Buyer”",
          "info": "Turn on only when the person really bought the product.",
          "default": false
        }
      ]
    }
  ],
  "presets": [{ "name": "Nicshape reviews" }]
}
{% endschema %}
