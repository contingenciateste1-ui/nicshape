<div class="nic-sizechart" data-nic-sizechart data-match="{{ block.settings.option_name | downcase | escape }}" style="--sc-bg: {{ block.settings.button_bg }}; --sc-text: {{ block.settings.button_text }};" {{ block.shopify_attributes }}>
  <button class="nic-sizechart__btn" type="button" data-sc-open>{{ block.settings.button_label }}</button>
  <dialog class="nic-sizechart__dialog" data-sc-dialog>
    <button class="nic-sizechart__close" type="button" data-sc-close aria-label="Close">×</button>
    {%- if block.settings.heading != blank -%}
      <h3 class="nic-sizechart__title">{{ block.settings.heading }}</h3>
    {%- endif -%}
    {%- if block.settings.image != blank -%}
      {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '600, 900, 1200', sizes: '(min-width: 750px) 600px, 90vw', alt: block.settings.heading }}
    {%- endif -%}
    {%- if block.settings.content != blank -%}
      <div class="nic-sizechart__content">{{ block.settings.content }}</div>
    {%- endif -%}
  </dialog>
</div>

<script>
  (function () {
    function init(root) {
      if (root.dataset.ready) return;
      root.dataset.ready = '1';
      var dlg = root.querySelector('[data-sc-dialog]');
      root.querySelector('[data-sc-open]').addEventListener('click', function () {
        if (dlg.showModal) dlg.showModal();
        else dlg.setAttribute('open', '');
      });
      root.querySelector('[data-sc-close]').addEventListener('click', function () {
        dlg.close();
      });
      dlg.addEventListener('click', function (e) {
        if (e.target === dlg) dlg.close();
      });
      var word = root.dataset.match;
      if (!word) return;
      var tries = 0;
      var t = setInterval(function () {
        tries++;
        var legends = document.querySelectorAll('variant-picker legend, variant-picker .variant-option__title, fieldset legend');
        for (var i = 0; i < legends.length; i++) {
          var lg = legends[i];
          if (lg.textContent.trim().toLowerCase().indexOf(word) === 0) {
            var host = lg.parentElement;
            host.style.position = 'relative';
            root.classList.add('is-inline');
            host.appendChild(root);
            clearInterval(t);
            return;
          }
        }
        if (tries > 20) clearInterval(t);
      }, 300);
    }
    document.querySelectorAll('[data-nic-sizechart]').forEach(init);
  })();
</script>

{% stylesheet %}
  .nic-sizechart {
    display: flex;
    justify-content: flex-end;
    width: 100%;
  }

  .nic-sizechart.is-inline {
    position: absolute;
    top: 0;
    right: 0;
    width: auto;
  }

  .nic-sizechart__btn {
    padding: 4px 14px;
    border: 0;
    border-radius: 999px;
    background: var(--sc-bg);
    color: var(--sc-text);
    font-family: var(--font-body--family);
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
  }

  .nic-sizechart__dialog {
    position: fixed;
    inset: 0;
    width: min(92vw, 680px);
    max-height: 88vh;
    margin: auto;
    padding: 28px;
    overflow: auto;
    border: 0;
    border-radius: 16px;
    background: #fff;
    color: #2b2224;
  }

  .nic-sizechart__dialog::backdrop {
    background: rgb(0 0 0 / 50%);
  }

  .nic-sizechart__dialog img {
    display: block;
    width: 100%;
    height: auto;
  }

  .nic-sizechart__title {
    margin: 0 36px 16px 0;
    font-size: 1.25rem;
  }

  .nic-sizechart__content {
    margin-top: 16px;
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .nic-sizechart__close {
    position: absolute;
    top: 10px;
    right: 14px;
    border: 0;
    background: transparent;
    color: inherit;
    font-size: 28px;
    line-height: 1;
    cursor: pointer;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Nicshape size chart",
  "tag": null,
  "settings": [
    { "type": "text", "id": "button_label", "label": "Button text", "default": "Size chart" },
    { "type": "text", "id": "option_name", "label": "Move button next to option named", "info": "Example: Size. The button moves to the right of that option title. Empty keeps it where this block is.", "default": "Size" },
    { "type": "text", "id": "heading", "label": "Popup title", "default": "Size chart" },
    { "type": "image_picker", "id": "image", "label": "Popup image (your size table)" },
    { "type": "richtext", "id": "content", "label": "Popup text (optional)" },
    { "type": "color", "id": "button_bg", "label": "Button background", "default": "#111111" },
    { "type": "color", "id": "button_text", "label": "Button text color", "default": "#ffffff" }
  ],
  "presets": [{ "name": "Nicshape size chart" }]
}
{% endschema %}
