{% doc %}
  @prompt
    Create a theme block called "Social proof line" for the product page.
    
    Layout: one horizontal row, vertically centered. On the left, a small "group of people" icon (two people silhouette, solid black). On the right, one line of text: "Bought 1655 times this week". Gap between the icon and the text is 10px.
    
    Style:
    - Icon size 22px, color #111111.
    - Text color #111111, size 16px, regular weight.
    - The number (1655) is bold and uses a brown/gold accent color #9a7b5a.
    - Left aligned.
    
    Editable settings:
    1. Text before the number (text, default "Bought")
    2. Number (text, default "1655")
    3. Text after the number (text, default "times this week")
    4. Show icon (checkbox, default on)
    5. Text size (range 12 to 24, default 16)
    6. Text color (color, default #111111)
    7. Number color (color, default #9a7b5a)
    8. Icon color (color, default #111111)
    
    If the Number field is empty, the whole block must be hidden.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% if block.settings.number != blank %}
  {% style %}
    .ai-social-proof-{{ ai_gen_id }} {
      display: block;
      width: {{ block.settings.desktop_width_percent }}%;
      max-width: 100%;
    }

    .ai-social-proof-{{ ai_gen_id }}__row {
      display: flex;
      align-items: center;
      justify-content: flex-start;
      gap: 10px;
      color: {{ block.settings.text_color }};
      font-size: {{ block.settings.text_size }}px;
      font-weight: 400;
      line-height: 1.3;
    }

    .ai-social-proof-{{ ai_gen_id }}__icon {
      display: block;
      width: 22px;
      height: 22px;
      flex: 0 0 22px;
      color: {{ block.settings.icon_color }};
    }

    .ai-social-proof-{{ ai_gen_id }}__copy {
      margin: 0;
      color: {{ block.settings.text_color }};
      font-size: inherit;
      font-weight: 400;
    }

    .ai-social-proof-{{ ai_gen_id }}__number {
      color: {{ block.settings.number_color }};
      font-weight: 700;
    }
  {% endstyle %}

  <div class="ai-social-proof-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
    <div class="ai-social-proof-{{ ai_gen_id }}__row">
      {% if block.settings.show_icon %}
        <svg class="ai-social-proof-{{ ai_gen_id }}__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
          <path d="M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm6.5-1a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7ZM9 13c-3.34 0-7 1.67-7 5v3h14v-3c0-3.33-3.66-5-7-5Zm6.5-.5c-.59 0-1.21.06-1.82.17 2.12 1.03 3.32 2.76 3.32 5.33v3h5v-2.5c0-3.61-3.39-6-6.5-6Z"/>
        </svg>
      {% endif %}
      <p class="ai-social-proof-{{ ai_gen_id }}__copy">
        {{ block.settings.text_before | escape }}{% if block.settings.text_before != blank %} {% endif %}<strong class="ai-social-proof-{{ ai_gen_id }}__number">{{ block.settings.number | escape }}</strong>{% if block.settings.text_after != blank %} {{ block.settings.text_after | escape }}{% endif %}
      </p>
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Social proof line",
  "settings": [
    {
      "type": "text",
      "id": "text_before",
      "label": "Text before number",
      "default": "Bought"
    },
    {
      "type": "text",
      "id": "number",
      "label": "Number",
      "default": "1655"
    },
    {
      "type": "text",
      "id": "text_after",
      "label": "Text after number",
      "default": "times this week"
    },
    {
      "type": "checkbox",
      "id": "show_icon",
      "label": "Show icon",
      "default": true
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "number_color",
      "label": "Number color",
      "default": "#9a7b5a"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#111111"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Social proof line"
    }
  ],
  "tag": null,
  "class": "social-proof-line"
}
{% endschema %}