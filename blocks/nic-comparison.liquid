{%- liquid
  assign n = 0
  for i in (1..7)
    assign k = 'r' | append: i | append: '_label'
    if block.settings[k] != blank
      assign n = n | plus: 1
    endif
  endfor
  assign last = n | minus: 1
-%}
{%- capture check_ring -%}<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><circle cx="12" cy="12" r="9.5" fill="none" stroke="#fff" stroke-width="1.6"/><path d="M8 12.4l2.7 2.6L16 9.6" fill="none" stroke="#fff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>{%- endcapture -%}
{%- capture yes_icon -%}<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><circle cx="12" cy="12" r="10.5" fill="var(--cmp-yes)" stroke="#fff" stroke-width="1.5"/><path d="M8 12.4l2.7 2.6L16 9.6" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>{%- endcapture -%}
{%- capture no_icon -%}<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><circle cx="12" cy="12" r="10.5" fill="#000" stroke="#fff" stroke-width="1.5"/><path d="M8.5 8.5l7 7M15.5 8.5l-7 7" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round"/></svg>{%- endcapture -%}

<div
  class="nic-cmp-wrap"
  style="
    --cmp-bg: {{ block.settings.bg_color }};
    --cmp-text: {{ block.settings.text_color }};
    --cmp-top: {{ block.settings.brand_top }};
    --cmp-bottom: {{ block.settings.brand_bottom }};
    --cmp-chead: {{ block.settings.comp_head }};
    --cmp-ctop: {{ block.settings.comp_top }};
    --cmp-cbottom: {{ block.settings.comp_bottom }};
    --cmp-yes: {{ block.settings.yes_color }};
    --cmp-label: {{ block.settings.label_bg }};
    --cmp-row: {{ block.settings.row_height }}px;
    --cmp-r: {{ block.settings.radius }}px;
    --cmp-pt: {{ block.settings.padding_top }}px;
    --cmp-pb: {{ block.settings.padding_bottom }}px;
  "
  {{ block.shopify_attributes }}
>
  <div class="nic-cmp">
    <div class="nic-cmp__intro">
      {%- if block.settings.heading != blank -%}<h2>{{ block.settings.heading }}</h2>{%- endif -%}
      {%- if block.settings.paragraph != blank -%}<p>{{ block.settings.paragraph }}</p>{%- endif -%}
    </div>

    <div class="nic-cmp__grid" role="table">
      <div class="nic-cmp__head nic-cmp__blank" role="presentation"></div>
      <div class="nic-cmp__head nic-cmp__head--brand" role="columnheader">
        {%- if block.settings.brand_logo != blank -%}
          {{ block.settings.brand_logo | image_url: width: 300 | image_tag: loading: 'lazy', alt: block.settings.brand_name }}
        {%- else -%}
          <span>{{ block.settings.brand_name }}</span>
        {%- endif -%}
      </div>
      <div class="nic-cmp__head nic-cmp__head--comp" role="columnheader"><span>{{ block.settings.c1_name }}</span></div>
      <div class="nic-cmp__head nic-cmp__head--comp" role="columnheader"><span>{{ block.settings.c2_name }}</span></div>

      {%- assign idx = 0 -%}
      {%- for i in (1..7) -%}
        {%- liquid
          assign lk = 'r' | append: i | append: '_label'
          assign bk = 'r' | append: i | append: '_brand'
          assign c1k = 'r' | append: i | append: '_c1'
          assign c2k = 'r' | append: i | append: '_c2'
          assign label = block.settings[lk]
        -%}
        {%- if label != blank -%}
          {%- liquid
            if last > 0
              assign t = idx | times: 100 | divided_by: last
            else
              assign t = 0
            endif
            assign inv = 100 | minus: t
            assign pos = ''
            if idx == 0
              assign pos = ' is-first'
            endif
            if idx == last
              assign pos = pos | append: ' is-last'
            endif
          -%}
          <div class="nic-cmp__label{{ pos }}" role="rowheader">{{ label }}</div>
          <div class="nic-cmp__cell nic-cmp__cell--brand{{ pos }}" style="--p: {{ inv }}%;" role="cell">
            {%- if block.settings[bk] -%}{{ check_ring }}{%- else -%}{{ no_icon }}{%- endif -%}
          </div>
          <div class="nic-cmp__cell nic-cmp__cell--comp{{ pos }}" style="--p: {{ inv }}%;" role="cell">
            {%- if block.settings[c1k] == 'yes' -%}{{ yes_icon }}{%- else -%}{{ no_icon }}{%- endif -%}
          </div>
          <div class="nic-cmp__cell nic-cmp__cell--comp{{ pos }}" style="--p: {{ inv }}%;" role="cell">
            {%- if block.settings[c2k] == 'yes' -%}{{ yes_icon }}{%- else -%}{{ no_icon }}{%- endif -%}
          </div>
          {%- assign idx = idx | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .nic-cmp-wrap {
    container-type: inline-size;
    padding: var(--cmp-pt) 16px var(--cmp-pb);
    background: var(--cmp-bg);
    color: var(--cmp-text);
    font-family: var(--font-body--family);
  }

  .nic-cmp {
    display: grid;
    gap: 24px;
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
  }

  .nic-cmp__intro {
    text-align: center;
  }

  .nic-cmp__intro h2 {
    margin: 0 0 14px;
    font-family: var(--font-heading--family);
    font-size: clamp(22px, 3cqw, 34px);
    font-weight: 700;
    line-height: 1.15;
  }

  .nic-cmp__intro p {
    margin: 0;
    font-size: 1rem;
    line-height: 1.5;
  }

  .nic-cmp__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) repeat(3, minmax(0, 1fr));
    column-gap: 8px;
  }

  .nic-cmp__head {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: calc(var(--cmp-row) * 1.5);
    padding: 8px;
    text-align: center;
  }

  .nic-cmp__blank {
    visibility: hidden;
  }

  .nic-cmp__head--brand {
    border-radius: var(--cmp-r) var(--cmp-r) 0 0;
    background: var(--cmp-top);
    color: #fff;
    font-size: 1.0625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .nic-cmp__head--brand img {
    display: block;
    max-width: 80%;
    max-height: 48px;
    object-fit: contain;
  }

  .nic-cmp__head--comp {
    border-radius: var(--cmp-r) var(--cmp-r) 0 0;
    background: var(--cmp-chead);
    font-size: 0.8125rem;
    font-weight: 700;
    line-height: 1.25;
  }

  .nic-cmp__label {
    display: flex;
    align-items: center;
    min-height: var(--cmp-row);
    padding: 10px 12px;
    border-bottom: 1px solid #ececec;
    background: var(--cmp-label);
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.25;
  }

  .nic-cmp__label.is-first {
    border-radius: var(--cmp-r) 0 0 0;
  }

  .nic-cmp__label.is-last {
    border-bottom: 0;
    border-radius: 0 0 0 var(--cmp-r);
  }

  .nic-cmp__cell {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: var(--cmp-row);
  }

  .nic-cmp__cell--brand {
    background: color-mix(in srgb, var(--cmp-top) var(--p), var(--cmp-bottom));
  }

  .nic-cmp__cell--comp {
    background: color-mix(in srgb, var(--cmp-ctop) var(--p), var(--cmp-cbottom));
  }

  .nic-cmp__cell.is-last {
    border-radius: 0 0 var(--cmp-r) var(--cmp-r);
  }

  @container (min-width: 720px) {
    .nic-cmp {
      grid-template-columns: 35% 1fr;
      gap: 32px;
    }
  }

  @container (max-width: 520px) {
    .nic-cmp__grid {
      grid-template-columns: minmax(0, 1.2fr) repeat(3, minmax(0, 1fr));
      column-gap: 5px;
    }

    .nic-cmp__label {
      min-height: 56px;
      padding: 8px;
      font-size: 0.75rem;
    }

    .nic-cmp__cell {
      min-height: 56px;
    }

    .nic-cmp__cell svg {
      width: 18px;
      height: 18px;
    }

    .nic-cmp__head {
      min-height: 72px;
      padding: 6px 4px;
    }

    .nic-cmp__head--brand {
      font-size: 0.75rem;
      letter-spacing: 0.06em;
    }

    .nic-cmp__head--comp {
      font-size: 0.6875rem;
    }
  }
{% endstylesheet %}

