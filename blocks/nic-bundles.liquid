{%- liquid
  assign product = closest.product
  assign multi = false
  if product.has_only_default_variant == false
    assign multi = true
  endif
-%}

{%- if product != blank -%}
{% style %}
  .product-information__grid {
    --sidebar-width: {{ block.settings.details_width }}px;
  }

  .product-form-buttons .add-to-cart-button,
  .product-form-buttons .add-to-cart-button.button {
    --button-background-color: {{ block.settings.button_color }};
    --button-color: {{ block.settings.button_text_color }};
    background: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    width: 100%;
    min-height: {{ block.settings.button_height }}px;
    border-radius: 999px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
{% endstyle %}
<nic-bundles
  class="nic-bundles"
  data-currency="{{ cart.currency.iso_code }}"
  data-locale="{{ request.locale.iso_code }}"
  data-cart-url="{{ routes.cart_url }}"
  data-add-url="{{ routes.cart_add_url }}.js"
  data-section="{{ section.id }}"
  style="
    --nb-accent: {{ block.settings.accent_color }};
    --nb-card-bg: {{ block.settings.card_bg }};
    --nb-radius: {{ block.settings.card_radius }}px;
    --nb-text: {{ block.settings.text_color }};
    --nb-price: {{ block.settings.price_color }};
    --nb-old: {{ block.settings.old_price_color }};
    --nb-pill-bg: {{ block.settings.pill_bg }};
    --nb-pill-text: {{ block.settings.pill_text }};
    --nb-gap: {{ block.settings.gap }}px;
    --nb-title: {{ block.settings.title_size }}px;
    --nb-price-size: {{ block.settings.price_size }}px;
  "
  {{ block.shopify_attributes }}
>
  <script type="application/json" data-nb-variants>
    [
      {%- for v in product.variants -%}
        {"id":{{ v.id }},"options":{{ v.options | json }},"price":{{ v.price }},"compare":{{ v.compare_at_price | default: 0 }},"available":{{ v.available | json }}}{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  </script>
  <script type="application/json" data-nb-options>
    {{ product.options_with_values | json }}
  </script>

  {%- for i in (1..3) -%}
    {%- liquid
      assign k = 'offer_' | append: i
      assign show = block.settings[k | append: '_show']
      assign title = block.settings[k | append: '_title']
      assign qty = block.settings[k | append: '_qty'] | plus: 0
      assign paid = block.settings[k | append: '_paid'] | plus: 0
      assign pill = block.settings[k | append: '_pill']
      assign ribbon = block.settings[k | append: '_ribbon']
      assign sub = block.settings[k | append: '_sub']
      assign selected = block.settings[k | append: '_selected']
    -%}
    {%- if show and title != blank -%}
      <div
        class="nb-offer{% if selected %} is-selected{% endif %}{% if ribbon != blank %} has-ribbon{% endif %}"
        data-nb-offer
        data-qty="{{ qty }}"
        data-paid="{{ paid }}"
        data-pill="{{ pill | escape }}"
      >
        {%- if ribbon != blank -%}<span class="nb-offer__ribbon">{{ ribbon }}</span>{%- endif -%}
        <button class="nb-offer__head" type="button" aria-pressed="{{ selected }}">
          <span class="nb-offer__radio" aria-hidden="true"></span>
          <span class="nb-offer__main">
            <span class="nb-offer__title">{{ title }}{% if pill != blank %} <span class="nb-offer__pill" data-nb-pill></span>{% endif %}</span>
            {%- if sub != blank -%}<span class="nb-offer__sub">{{ sub }}</span>{%- endif -%}
          </span>
          <span class="nb-offer__prices">
            <span class="nb-offer__price" data-nb-price></span>
            <span class="nb-offer__old" data-nb-old></span>
          </span>
        </button>
        {%- if multi and qty > 1 -%}
          <div class="nb-offer__units" data-nb-units></div>
        {%- endif -%}
      </div>
    {%- endif -%}
  {%- endfor -%}

  {%- if block.settings.proof_count != blank -%}
    <p class="nb-proof">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M16 11a3 3 0 1 0-3-3 3 3 0 0 0 3 3zm-8 0a3 3 0 1 0-3-3 3 3 0 0 0 3 3zm0 2c-2.3 0-7 1.2-7 3.5V19h14v-2.5C15 14.2 10.3 13 8 13zm8 0c-.3 0-.6 0-1 .1 1.2.8 2 1.9 2 3.4V19h6v-2.5c0-2.3-4.7-3.5-7-3.5z"/></svg>
      <span>{{ block.settings.proof_before }} <strong>{{ block.settings.proof_count }}</strong> {{ block.settings.proof_after }}</span>
    </p>
  {%- endif -%}
</nic-bundles>

<script>
  (function () {
    if (customElements.get('nic-bundles')) return;
    customElements.define(
      'nic-bundles',
      class extends HTMLElement {
        connectedCallback() {
          this.variants = JSON.parse(this.querySelector('[data-nb-variants]').textContent);
          this.options = JSON.parse(this.querySelector('[data-nb-options]').textContent);
          this.fmt = new Intl.NumberFormat(this.dataset.locale || undefined, {
            style: 'currency',
            currency: this.dataset.currency,
          });
          this.offers = Array.from(this.querySelectorAll('[data-nb-offer]'));
          this.selects = [];
          this.offers.forEach((o) => {
            o.querySelector('.nb-offer__head').addEventListener('click', () => this.select(o));
          });
          this.current = this.mainVariant() || this.variants[0];
          this.offers.forEach((o) => this.buildUnits(o));
          this.select(this.querySelector('.is-selected') || this.offers[0], true);
          this.lastId = this.current.id;
          this.timer = setInterval(() => {
            const v = this.mainVariant();
            if (v && v.id !== this.lastId) {
              this.lastId = v.id;
              this.current = v;
              this.offers.forEach((o) => this.syncFirst(o));
              this.render();
            }
          }, 350);
          this.interceptAdd();
        }
        disconnectedCallback() {
          clearInterval(this.timer);
        }
        mainVariant() {
          const input = document.querySelector('form[data-type="add-to-cart-form"] input[name="id"]');
          if (!input) return null;
          return this.variants.find((v) => String(v.id) === String(input.value));
        }
        buildUnits(offer) {
          const box = offer.querySelector('[data-nb-units]');
          if (!box) return;
          const qty = parseInt(offer.dataset.qty, 10);
          const names = this.options.map((o) => o.name).join(', ');
          let html = '<p class="nb-units__label">' + names + '</p>';
          for (let n = 1; n <= qty; n++) {
            html += '<div class="nb-unit" data-unit="' + n + '"><span class="nb-unit__n">#' + n + '</span>';
            this.options.forEach((opt, idx) => {
              html += '<select class="nb-select" data-opt="' + idx + '" aria-label="' + opt.name + ' #' + n + '">';
              opt.values.forEach((val) => {
                html += '<option value="' + String(val).replace(/"/g, '&quot;') + '">' + val + '</option>';
              });
              html += '</select>';
            });
            html += '</div>';
          }
          box.innerHTML = html;
          this.syncAll(offer);
          box.addEventListener('change', () => this.render());
        }
        syncAll(offer) {
          offer.querySelectorAll('.nb-unit').forEach((u) => {
            u.querySelectorAll('select').forEach((s) => {
              s.value = this.current.options[parseInt(s.dataset.opt, 10)];
            });
          });
        }
        syncFirst(offer) {
          const u = offer.querySelector('.nb-unit');
          if (!u) return;
          u.querySelectorAll('select').forEach((s) => {
            s.value = this.current.options[parseInt(s.dataset.opt, 10)];
          });
        }
        select(offer, silent) {
          this.offers.forEach((o) => {
            const on = o === offer;
            o.classList.toggle('is-selected', on);
            o.querySelector('.nb-offer__head').setAttribute('aria-pressed', on ? 'true' : 'false');
          });
          this.selected = offer;
          this.render();
        }
        render() {
          const v = this.current;
          this.offers.forEach((o) => {
            const qty = parseInt(o.dataset.qty, 10);
            const paid = parseInt(o.dataset.paid, 10) || qty;
            const total = v.price * paid;
            const old = (v.compare > v.price ? v.compare : v.price) * qty;
            o.querySelector('[data-nb-price]').textContent = this.fmt.format(total / 100);
            const oldEl = o.querySelector('[data-nb-old]');
            oldEl.textContent = old > total ? this.fmt.format(old / 100) : '';
            const pill = o.querySelector('[data-nb-pill]');
            if (pill) {
              const pct = old > total ? Math.round((1 - total / old) * 100) : 0;
              pill.textContent = o.dataset.pill.replace('{percent}', pct);
              pill.hidden = pct <= 0 && o.dataset.pill.indexOf('{percent}') > -1;
            }
          });
        }
        itemsFor(offer) {
          const qty = parseInt(offer.dataset.qty, 10);
          const units = offer.querySelectorAll('.nb-unit');
          const counts = {};
          if (!units.length) {
            return [{ id: this.current.id, quantity: qty }];
          }
          units.forEach((u) => {
            const opts = Array.from(u.querySelectorAll('select')).map((s) => s.value);
            const match = this.variants.find((v) => v.options.every((x, i) => String(x) === String(opts[i])));
            const id = (match || this.current).id;
            counts[id] = (counts[id] || 0) + 1;
          });
          return Object.keys(counts).map((id) => ({ id: Number(id), quantity: counts[id] }));
        }
        interceptAdd() {
          document.addEventListener(
            'click',
            async (e) => {
              const btn = e.target.closest('.add-to-cart-button');
              if (!btn || !this.isConnected) return;
              const offer = this.selected;
              if (!offer || parseInt(offer.dataset.qty, 10) <= 1) return;
              e.preventDefault();
              e.stopImmediatePropagation();
              btn.setAttribute('aria-busy', 'true');
              try {
                const res = await fetch(this.dataset.addUrl, {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
                  body: JSON.stringify({ items: this.itemsFor(offer) }),
                });
                if (!res.ok) throw new Error('add failed');
                window.location.href = this.dataset.cartUrl;
              } catch (err) {
                btn.removeAttribute('aria-busy');
                alert('Could not add to cart. Please check the selected options.');
              }
            },
            true
          );
        }
      }
    );
  })();
</script>

{%- endif -%}

{% stylesheet %}
  .nic-bundles {
    display: flex;
    flex-direction: column;
    gap: var(--nb-gap);
    width: 100%;
    margin-block: 8px;
    color: var(--nb-text);
    font-family: var(--font-body--family);
  }

  .nb-offer {
    position: relative;
    border: 2px solid #e6e1de;
    border-radius: var(--nb-radius);
    background: #fff;
  }

  .nb-offer.is-selected {
    border-color: var(--nb-accent);
    background: var(--nb-card-bg);
  }

  .nb-offer__ribbon {
    position: absolute;
    top: -2px;
    right: 22px;
    padding: 3px 12px;
    border-radius: 0 0 8px 8px;
    background: var(--nb-accent);
    color: #fff;
    font-size: 12px;
    font-weight: 700;
    transform: translateY(-100%);
    border-radius: 8px 8px 0 0;
  }

  .nb-offer__head {
    display: flex;
    align-items: center;
    gap: 14px;
    width: 100%;
    padding: 20px 18px;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .nb-offer__radio {
    flex: 0 0 22px;
    width: 22px;
    height: 22px;
    border: 2px solid #d8d0b8;
    border-radius: 50%;
    background: #fff;
  }

  .nb-offer.is-selected .nb-offer__radio {
    border: 6px solid var(--nb-accent);
  }

  .nb-offer__main {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 4px;
  }

  .nb-offer__title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-size: var(--nb-title);
    font-weight: 800;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .nb-offer__pill {
    padding: 3px 9px;
    border-radius: 999px;
    background: var(--nb-pill-bg);
    color: var(--nb-pill-text);
    font-size: 11px;
    font-weight: 700;
  }

  .nb-offer__pill[hidden] {
    display: none;
  }

  .nb-offer__sub {
    font-size: 14px;
    opacity: 0.75;
  }

  .nb-offer__prices {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 2px;
  }

  .nb-offer__price {
    color: var(--nb-price);
    font-size: var(--nb-price-size);
    font-weight: 600;
  }

  .nb-offer__old {
    color: var(--nb-old);
    font-size: 14px;
    text-decoration: line-through;
  }

  .nb-offer__units {
    display: none;
    padding: 0 18px 18px;
  }

  .nb-offer.is-selected .nb-offer__units {
    display: block;
  }

  .nb-units__label {
    margin: 0 0 10px;
    font-size: 14px;
    font-weight: 700;
  }

  .nb-unit {
    display: grid;
    grid-template-columns: 26px 1fr 1fr;
    gap: 8px;
    align-items: center;
    margin-bottom: 8px;
  }

  .nb-unit__n {
    font-size: 14px;
    font-weight: 700;
  }

  .nb-select {
    width: 100%;
    min-width: 0;
    padding: 9px 10px;
    border: 1px solid #d6d6d6;
    border-radius: 4px;
    background: #f1f1f1;
    color: inherit;
    font: inherit;
    font-size: 14px;
  }

  .nb-proof {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 14px 0 0;
    font-size: 15px;
  }

  .nb-proof strong {
    color: var(--nb-accent);
    font-weight: 700;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Nicshape bundle offers",
  "tag": null,
  "settings": [
    { "type": "paragraph", "content": "Offers add several units of this product to the cart. For the free item, create an automatic discount (for example “Buy 2 get 1 free”) in Shopify admin → Discounts." },
    { "type": "header", "content": "Offer 1" },
    { "type": "checkbox", "id": "offer_1_show", "label": "Show", "default": true },
    { "type": "text", "id": "offer_1_title", "label": "Title", "default": "Buy 1" },
    { "type": "select", "id": "offer_1_qty", "label": "Units added", "options": [{ "value": "1", "label": "1" }, { "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" }, { "value": "5", "label": "5" }, { "value": "6", "label": "6" }], "default": "1" },
    { "type": "select", "id": "offer_1_paid", "label": "Units charged", "info": "Use fewer than “Units added” to show a free item.", "options": [{ "value": "1", "label": "1" }, { "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" }, { "value": "5", "label": "5" }, { "value": "6", "label": "6" }], "default": "1" },
    { "type": "text", "id": "offer_1_pill", "label": "Pill", "info": "Use {percent} to show the calculated discount. Empty hides it." },
    { "type": "text", "id": "offer_1_ribbon", "label": "Ribbon (top right)" },
    { "type": "text", "id": "offer_1_sub", "label": "Small text" },
    { "type": "checkbox", "id": "offer_1_selected", "label": "Selected by default", "default": false },
    { "type": "header", "content": "Offer 2" },
    { "type": "checkbox", "id": "offer_2_show", "label": "Show", "default": true },
    { "type": "text", "id": "offer_2_title", "label": "Title", "default": "Buy 2 Get 1 Free" },
    { "type": "select", "id": "offer_2_qty", "label": "Units added", "options": [{ "value": "1", "label": "1" }, { "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" }, { "value": "5", "label": "5" }, { "value": "6", "label": "6" }], "default": "3" },
    { "type": "select", "id": "offer_2_paid", "label": "Units charged", "options": [{ "value": "1", "label": "1" }, { "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" }, { "value": "5", "label": "5" }, { "value": "6", "label": "6" }], "default": "2" },
    { "type": "text", "id": "offer_2_pill", "label": "Pill" },
    { "type": "text", "id": "offer_2_ribbon", "label": "Ribbon (top right)", "default": "Best Seller" },
    { "type": "text", "id": "offer_2_sub", "label": "Small text", "default": "Free Shipping" },
    { "type": "checkbox", "id": "offer_2_selected", "label": "Selected by default", "default": true },
    { "type": "header", "content": "Offer 3" },
    { "type": "checkbox", "id": "offer_3_show", "label": "Show", "default": false },
    { "type": "text", "id": "offer_3_title", "label": "Title", "default": "Buy 3 Get 2 Free" },
    { "type": "select", "id": "offer_3_qty", "label": "Units added", "options": [{ "value": "1", "label": "1" }, { "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" }, { "value": "5", "label": "5" }, { "value": "6", "label": "6" }], "default": "5" },
    { "type": "select", "id": "offer_3_paid", "label": "Units charged", "options": [{ "value": "1", "label": "1" }, { "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" }, { "value": "5", "label": "5" }, { "value": "6", "label": "6" }], "default": "3" },
    { "type": "text", "id": "offer_3_pill", "label": "Pill" },
    { "type": "text", "id": "offer_3_ribbon", "label": "Ribbon (top right)" },
    { "type": "text", "id": "offer_3_sub", "label": "Small text" },
    { "type": "checkbox", "id": "offer_3_selected", "label": "Selected by default", "default": false },
    { "type": "header", "content": "Social proof line" },
    { "type": "text", "id": "proof_before", "label": "Text before number", "default": "Bought" },
    { "type": "text", "id": "proof_count", "label": "Number", "info": "Leave empty to hide the line. Only use a real number from your store." },
    { "type": "text", "id": "proof_after", "label": "Text after number", "default": "times this week" },
    { "type": "header", "content": "Product page layout" },
    { "type": "range", "id": "details_width", "label": "Info column width (desktop)", "info": "Width of the column with title, price and buy button. The gallery uses the rest.", "min": 360, "max": 640, "step": 10, "unit": "px", "default": 440 },
    { "type": "header", "content": "Add to cart button" },
    { "type": "color", "id": "button_color", "label": "Button color", "default": "#5a4a42" },
    { "type": "color", "id": "button_text_color", "label": "Button text color", "default": "#ffffff" },
    { "type": "range", "id": "button_height", "label": "Button height", "min": 40, "max": 80, "step": 2, "unit": "px", "default": 52 },
    { "type": "header", "content": "Style" },
    { "type": "color", "id": "accent_color", "label": "Accent (selected border, radio)", "default": "#b97a65" },
    { "type": "color", "id": "card_bg", "label": "Selected card background", "default": "#fbf8f6" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#2b2224" },
    { "type": "color", "id": "price_color", "label": "Price", "default": "#2b2224" },
    { "type": "color", "id": "old_price_color", "label": "Old price", "default": "#777777" },
    { "type": "color", "id": "pill_bg", "label": "Pill background", "default": "#c98e72" },
    { "type": "color", "id": "pill_text", "label": "Pill text", "default": "#ffffff" },
    { "type": "range", "id": "card_radius", "label": "Corner roundness", "min": 0, "max": 24, "step": 2, "unit": "px", "default": 10 },
    { "type": "range", "id": "gap", "label": "Gap between offers", "min": 6, "max": 40, "step": 2, "unit": "px", "default": 14 },
    { "type": "range", "id": "title_size", "label": "Title size", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "price_size", "label": "Price size", "min": 12, "max": 28, "step": 1, "unit": "px", "default": 17 }
  ],
  "presets": [{ "name": "Nicshape bundle offers" }]
}
{% endschema %}
