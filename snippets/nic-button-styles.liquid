{%- doc -%}
  Shared Nicshape styles: buttons, section headings and visually-hidden helper.
  Render once per section that uses .nic-btn / .nic-heading.
{%- enddoc -%}

{% stylesheet %}
  .nic-btn {
    --nic-btn-bg: #2b2224;
    --nic-btn-fg: #ffffff;

    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding: 16px 40px;
    border: 0;
    border-radius: 999px;
    background: var(--nic-btn-bg);
    color: var(--nic-btn-fg);
    font-family: var(--font-body--family);
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 0.06em;
    line-height: 1;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    transition:
      transform 0.2s ease,
      opacity 0.2s ease;
  }

  .nic-btn:hover {
    opacity: 0.9;
    transform: translateY(-1px);
  }

  .nic-btn:focus-visible {
    outline: 2px solid currentcolor;
    outline-offset: 3px;
  }

  .nic-heading {
    margin: 0 0 8px;
    font-family: var(--font-heading--family);
    font-size: clamp(1.375rem, 1.1rem + 1vw, 1.875rem);
    font-weight: 700;
    line-height: 1.2;
    text-align: center;
  }

  .nic-subheading {
    margin: 0 0 24px;
    text-align: center;
    opacity: 0.75;
  }

  .nic-placeholder {
    display: block;
    width: 100%;
    height: 100%;
    background: #f3e7e2;
    fill: #c98e86;
    object-fit: cover;
  }
{% endstylesheet %}
